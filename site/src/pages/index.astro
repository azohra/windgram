---
import ChoosePath from "../components/home/ChoosePath.astro";
import FeaturedResearch from "../components/home/FeaturedResearch.astro";
import HomeHero from "../components/home/HomeHero.astro";
import HomeIndex from "../components/home/HomeIndex.astro";
import HomeTeachingWindgram from "../components/home/HomeTeachingWindgram.astro";
import MissionLineage from "../components/home/MissionLineage.astro";
import Base from "../layouts/Base.astro";
import { researchArticles } from "../lib/research";

const featuredResearch = researchArticles()
  .filter((entry) => entry.status === "current")
  .slice(0, 3);
---

<Base
  title="Windgram — Open windgram infrastructure for free flight"
  description="An open Python pipeline, versioned JSON contract, and headless npm renderer for publishing inspectable free-flight windgrams."
>
  <main id="main-content" class="home-main">
    <HomeHero />
    <HomeIndex />
    <HomeTeachingWindgram />
    <ChoosePath />
    <FeaturedResearch entries={featuredResearch} />
    <MissionLineage />
  </main>
</Base>

<style>
  .home-main {
    overflow: clip;
  }

  .home-main :global(section[id]) {
    scroll-margin-top: 4.5rem;
  }

  @media (max-width: 40rem) {
    :global(.site-header) {
      align-items: flex-start;
      flex-direction: column;
    }

    :global(.site-nav) {
      justify-content: space-between;
      width: 100%;
      gap: 0.5rem;
    }
  }
</style>
