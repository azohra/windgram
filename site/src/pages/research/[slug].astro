---
import Base from "../../layouts/Base.astro";
import {
  researchArticles,
  splitAfterHeading,
  splitBeforeHeading,
  type DocPage,
} from "../../lib/research";
import ArticleMeta from "../../components/research/ArticleMeta.astro";
import ArticleNav from "../../components/research/ArticleNav.astro";
import DocToc from "../../components/research/DocToc.astro";
import CapabilityMatrix from "../../components/research/CapabilityMatrix.astro";
import DerivationFlow from "../../components/research/DerivationFlow.astro";
import FailureAtlas from "../../components/research/FailureAtlas.astro";
import LiftProfileDiagram from "../../components/research/LiftProfileDiagram.astro";
import ModelHorizonChart from "../../components/research/ModelHorizonChart.astro";
import PipelineDiagram from "../../components/research/PipelineDiagram.astro";
import QuantityHomes from "../../components/research/QuantityHomes.astro";
import TwoTransports from "../../components/research/TwoTransports.astro";
import SpreadDiagram from "../../components/research/SpreadDiagram.astro";
import MemberAccounting from "../../components/research/MemberAccounting.astro";
import InteractiveChart from "../../components/research/InteractiveChart.astro";
import ExampleWindgram from "../../components/research/ExampleWindgram.astro";
import HomeWindgram from "../../components/research/HomeWindgram.astro";
import WindBarbGuide from "../../components/research/WindBarbGuide.astro";
import PressureTendency from "../../components/research/PressureTendency.astro";
import StabilityGuide from "../../components/research/StabilityGuide.astro";
import MoistureSignals from "../../components/research/MoistureSignals.astro";
import MoisturePrecipCase from "../../components/research/MoisturePrecipCase.astro";
import StabilityRampStrips from "../../components/research/StabilityRampStrips.astro";
import CloudBaseDeltas from "../../components/research/CloudBaseDeltas.astro";
import RampAdjacentDeltaE from "../../components/research/RampAdjacentDeltaE.astro";

export function getStaticPaths() {
  return researchArticles().map((doc) => ({ params: { slug: doc.slug }, props: { doc } }));
}

const { doc } = Astro.props;
const entries = researchArticles();

// The markdown in research/*.md is the single source of truth. This decides
// where diagrams, the table of contents, and the live chart enter the
// rendered HTML, anchored to stable heading ids.
type Part =
  | { type: "html"; value: string }
  | { type: "toc" }
  | { type: "derivation" }
  | { type: "failures" }
  | { type: "lift-profile" }
  | { type: "horizons" }
  | { type: "pipeline" }
  | { type: "two-transports" }
  | { type: "quantity-homes" }
  | { type: "capability-matrix" }
  | { type: "spread" }
  | { type: "member-accounting" }
  | { type: "chart"; defaultCompare?: boolean }
  | { type: "example-windgram" }
  | { type: "windgram-detail"; view: "full" | "lines" }
  | { type: "wind-barbs" }
  | { type: "pressure" }
  | { type: "stability-guide" }
  | { type: "moisture-signals" }
  | { type: "moisture-precip" }
  | { type: "ramp-strips" }
  | { type: "cloud-base-deltas" }
  | { type: "ramp-delta-e" };

function buildParts(doc: DocPage): Part[] {
  if (doc.slug === "reading-a-windgram") {
    const [intro, fromFirstPass] = splitBeforeHeading(
      doc.html,
      "check-lift-climb-limits-wind-surface-forcing-and-pressure",
    );
    const [firstPass, fromLayers] = splitBeforeHeading(
      fromFirstPass,
      "pressure-precipitation-cloud-and-w-use-separate-scales",
    );
    const [layers, fromPressure] = splitBeforeHeading(fromLayers, "read-pressure-as-a-tendency");
    const [pressure, fromStability] = splitBeforeHeading(
      fromPressure,
      "read-the-stability-scale-against-a-rising-parcel",
    );
    const [stability, fromMoisture] = splitBeforeHeading(
      fromStability,
      "separate-cloud-cover-cloud-base-and-cross-hatching",
    );
    const [moisture, fromPrecipitation] = splitBeforeHeading(
      fromMoisture,
      "precipitation-is-not-automatically-rain",
    );
    const [precipitation, fromLines] = splitBeforeHeading(
      fromPrecipitation,
      "boundary-layer-top-usable-lift-top-and-cloud-base-answer-different-questions",
    );
    const [lines, fromWind] = splitBeforeHeading(fromLines, "wind-barbs-read-the-flight-band");
    const [wind, remainder] = splitBeforeHeading(fromWind, "what-the-chart-cannot-decide");
    return [
      { type: "html", value: intro },
      // The intro's closing line names the fixed example; the reference
      // renderer's own interactive rendering of that document sits right
      // under it, so every later section reads against a chart the reader
      // can strip back layer by layer.
      { type: "example-windgram" },
      { type: "html", value: firstPass },
      { type: "html", value: layers },
      { type: "html", value: pressure },
      { type: "pressure" },
      { type: "html", value: stability },
      { type: "stability-guide" },
      { type: "html", value: moisture },
      { type: "moisture-signals" },
      { type: "html", value: precipitation },
      { type: "moisture-precip" },
      { type: "html", value: lines },
      { type: "windgram-detail", view: "lines" },
      { type: "html", value: wind },
      { type: "wind-barbs" },
      { type: "html", value: remainder },
    ];
  }

  if (doc.slug === "windgram-derivations") {
    const [intro, body] = splitBeforeHeading(doc.html, "required-surface-and-pressure-level-fields");
    return [
      { type: "html", value: intro },
      { type: "derivation" },
      { type: "toc" },
      { type: "html", value: body },
    ];
  }

  if (doc.slug === "usable-lift-and-boundary-layer") {
    const [beforeDiagram, afterDiagram] = splitBeforeHeading(
      doc.html,
      "why-usable-lift-top-can-cross-boundary-layer-top",
    );
    return [
      { type: "html", value: beforeDiagram },
      { type: "lift-profile" },
      { type: "html", value: afterDiagram },
    ];
  }

  if (doc.slug === "static-forecast-pipeline") {
    const [intro, body] = splitBeforeHeading(
      doc.html,
      "each-model-builder-follows-the-same-run-contract",
    );
    // The figure sits directly under the transport section's heading: it
    // shows the two mechanisms the prose then argues about.
    const [throughTransportHeading, transportDetails] = splitAfterHeading(
      body,
      "two-transports-byte-ranges-and-whole-domain-streams",
    );
    return [
      { type: "html", value: intro },
      { type: "pipeline" },
      { type: "toc" },
      { type: "html", value: throughTransportHeading },
      { type: "two-transports" },
      { type: "html", value: transportDetails },
    ];
  }

  if (doc.slug === "forecast-data-validation-failures") {
    const [intro, body] = splitBeforeHeading(doc.html, "a-wcs-crop-sampled-the-wrong-cells");
    return [
      { type: "html", value: intro },
      { type: "failures" },
      { type: "toc" },
      { type: "html", value: body },
    ];
  }

  if (doc.slug === "ensemble-spread") {
    const [beforeCeiling, fromCeiling] = splitBeforeHeading(
      doc.html,
      "the-column-ceiling-and-500-hpa",
    );
    const [ceilingSection, afterCeiling] = splitBeforeHeading(
      fromCeiling,
      "read-spread-in-this-order",
    );
    return [
      { type: "html", value: beforeCeiling },
      { type: "member-accounting" },
      { type: "html", value: ceilingSection },
      { type: "spread" },
      { type: "html", value: afterCeiling },
    ];
  }

  if (doc.slug === "why-this-project-exists") {
    // The figure closes the one-home-per-quantity section: the prose argues
    // the split, then the picture shows it before the transports section.
    const [throughOneHome, afterOneHome] = splitBeforeHeading(
      doc.html,
      "transports-follow-the-data",
    );
    return [
      { type: "html", value: throughOneHome },
      { type: "quantity-homes" },
      { type: "html", value: afterOneHome },
    ];
  }

  if (doc.slug === "model-capabilities") {
    // The matrix sits under the closing section's heading — the section that
    // names the catalogue as the machine-readable version of the entry.
    const [throughRenderHeading, renderBody] = splitAfterHeading(
      doc.html,
      "render-the-declaration-not-an-assumption",
    );
    return [
      { type: "html", value: throughRenderHeading },
      { type: "capability-matrix" },
      { type: "html", value: renderBody },
    ];
  }

  if (doc.slug === "stability-ramp") {
    // Each figure closes the section that argues it: the swatch strips end
    // the lineage section (both palettes on their own surfaces, grayscale
    // rows showing what each design keeps), and the ΔE bars end the
    // measurement section (the repaired pair against the floors).
    const [throughLineage, fromMeasured] = splitBeforeHeading(doc.html, "measured-not-eyeballed");
    const [measured, remainder] = splitBeforeHeading(fromMeasured, "one-look");
    return [
      { type: "html", value: throughLineage },
      { type: "ramp-strips" },
      { type: "html", value: measured },
      { type: "ramp-delta-e" },
      { type: "html", value: remainder },
    ];
  }

  if (doc.slug === "retiring-121-metres-per-degree") {
    // The figure closes the measured-consequences section: the prose walks
    // the two tables, then the picture shows the de-capped hours falling
    // out of the small uniform cloud-base shifts.
    const [throughMeasured, afterMeasured] = splitBeforeHeading(doc.html, "what-stays-fixed");
    return [
      { type: "html", value: throughMeasured },
      { type: "cloud-base-deltas" },
      { type: "html", value: afterMeasured },
    ];
  }

  if (doc.slug === "choosing-forecast-models") {
    const [intro, body] = splitBeforeHeading(
      doc.html,
      "choose-by-lead-time-and-required-terrain-detail",
    );
    return [
      { type: "html", value: intro },
      { type: "horizons" },
      { type: "html", value: body },
      { type: "chart", defaultCompare: true },
    ];
  }

  return [{ type: "html", value: doc.html }];
}

const parts = buildParts(doc);
---

<Base title={`${doc.title} — Windgram`} description={doc.dek} activeNav="research">
  <main class="shell prose">
    <p class="back-link"><a href="/">&larr; Research</a></p>
    <ArticleMeta doc={doc} />
    {
      parts.map((part) =>
        part.type === "html" ? (
          <Fragment set:html={part.value} />
        ) : part.type === "toc" ? (
          <DocToc toc={doc.toc} />
        ) : part.type === "derivation" ? (
          <DerivationFlow />
        ) : part.type === "failures" ? (
          <FailureAtlas />
        ) : part.type === "lift-profile" ? (
          <LiftProfileDiagram />
        ) : part.type === "horizons" ? (
          <ModelHorizonChart />
        ) : part.type === "pipeline" ? (
          <PipelineDiagram />
        ) : part.type === "two-transports" ? (
          <TwoTransports />
        ) : part.type === "quantity-homes" ? (
          <QuantityHomes />
        ) : part.type === "capability-matrix" ? (
          <CapabilityMatrix />
        ) : part.type === "spread" ? (
          <SpreadDiagram />
        ) : part.type === "member-accounting" ? (
          <MemberAccounting />
        ) : part.type === "chart" ? (
          <InteractiveChart defaultCompare={part.defaultCompare} />
        ) : part.type === "example-windgram" ? (
          <ExampleWindgram />
        ) : part.type === "windgram-detail" ? (
          <HomeWindgram view={part.view} />
        ) : part.type === "wind-barbs" ? (
          <WindBarbGuide />
        ) : part.type === "pressure" ? (
          <PressureTendency />
        ) : part.type === "stability-guide" ? (
          <StabilityGuide />
        ) : part.type === "moisture-signals" ? (
          <MoistureSignals />
        ) : part.type === "moisture-precip" ? (
          <MoisturePrecipCase />
        ) : part.type === "ramp-strips" ? (
          <StabilityRampStrips />
        ) : part.type === "cloud-base-deltas" ? (
          <CloudBaseDeltas />
        ) : part.type === "ramp-delta-e" ? (
          <RampAdjacentDeltaE />
        ) : null,
      )
    }
    <ArticleNav current={doc} entries={entries} />
  </main>
</Base>
