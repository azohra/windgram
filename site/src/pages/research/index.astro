---
import Base from "../../layouts/Base.astro";
import ResearchThumbnail from "../../components/research/ResearchThumbnail.astro";
import { researchArticles } from "../../lib/research";

const entries = researchArticles();
const dateFormat = new Intl.DateTimeFormat("en-CA", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
});

function kindLabel(kind: (typeof entries)[number]["researchKind"]): string {
  if (kind === "case-study") return "Case study";
  if (kind === "experiment") return "Experiment";
  return "Method";
}
---

<Base
  title="Research — Windgram"
  description="Methods, experiments, and case studies behind the open windgram pipeline and renderer."
  activeNav="research"
>
  <main class="shell research-shell">
    <header class="research-header">
      <p class="eyebrow">Research ledger</p>
      <h1>Methods, evidence, and decisions</h1>
      <p>
        Dated accounts of how the pipeline, data contract, and reference renderer are derived and
        tested.
      </p>
    </header>

    <section class="entries-section" aria-label="Research articles">
      <ol class="entry-list">
        {
          entries.map((entry) => (
            <li>
              <span class="entry-number">{entry.number}</span>
              <div class="entry-copy">
                <div class="entry-meta">
                  <span>{kindLabel(entry.researchKind)}</span>
                  <span>{entry.section}</span>
                  {entry.published && <time datetime={entry.published.toISOString()}>{dateFormat.format(entry.published)}</time>}
                  <span>{entry.readingMinutes} min</span>
                  {entry.status === "historical" && <span>Historical</span>}
                </div>
                <h2><a href={entry.url}>{entry.title}</a></h2>
                <p>{entry.summary}</p>
              </div>
              <a class="entry-thumbnail" href={entry.url} aria-label={`Read ${entry.title}`}>
                <ResearchThumbnail entry={entry} />
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </main>
</Base>

<style>
  .research-shell {
    max-width: 1100px;
    padding-bottom: 42px;
  }
  .research-header {
    position: relative;
    padding: 54px 0 32px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .research-header::after {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 116px;
    height: 4px;
    background: var(--accent);
    content: "";
  }
  .eyebrow {
    margin: 0 0 12px;
    font: 600 12px/1.4 var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .research-header h1 {
    max-width: 780px;
    margin: 0;
    font-size: clamp(48px, 6vw, 68px);
    line-height: 0.95;
  }
  .research-header > p:last-child {
    max-width: 780px;
    margin: 20px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .entries-section {
    padding-bottom: 38px;
  }
  .entry-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .entry-list li {
    display: grid;
    grid-template-columns: 82px minmax(0, 1fr) 250px;
    gap: 24px;
    padding: 24px 0 25px;
    border-bottom: 1px solid var(--rule);
  }
  .entry-number {
    padding-top: 5px;
    font: 700 42px/0.9 var(--display);
    color: var(--accent);
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    font: 11.5px/1.4 var(--mono);
    letter-spacing: 0.045em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .entry-meta span + span::before,
  .entry-meta span + time::before,
  .entry-meta time + span::before {
    margin: 0 7px;
    color: var(--rule-strong);
    content: "/";
  }
  .entry-copy h2 {
    margin: 7px 0 9px;
    font-size: 28px;
    line-height: 1.12;
  }
  .entry-copy h2 a {
    color: var(--ink);
  }
  .entry-copy p {
    max-width: 790px;
    margin: 0;
    font-size: 17px;
    line-height: 1.55;
    color: var(--ink-soft);
  }
  .entry-thumbnail { display: block; align-self: center; color: inherit; text-decoration: none; }
  .entry-thumbnail:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  @media (max-width: 900px) {
    .entry-list li { grid-template-columns: 64px minmax(0, 1fr); }
    .entry-thumbnail { grid-column: 2; width: min(100%, 420px); }
  }
  @media (max-width: 680px) {
    .research-header {
      padding-top: 38px;
    }
    .research-header h1 {
      font-size: 46px;
    }
    .entry-list li {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 14px;
    }
    .entry-number {
      font-size: 31px;
    }
    .entry-copy h2 {
      font-size: 22px;
    }
  }
</style>
