---
import Base from "../../layouts/Base.astro";
import DocToc from "../../components/research/DocToc.astro";
import { integrationDoc, splitBeforeHeading } from "../../lib/research";

// The guide below IS packages/windgram/README.md, rendered from the repo at
// build time — the same one-home pattern the research pages use, so npm,
// GitHub, and this page can never disagree. Only the short landing above it
// lives here.
const doc = integrationDoc();
const firstSection = doc.toc[0];
const [intro, body] = firstSection ? splitBeforeHeading(doc.html, firstSection.id) : [doc.html, ""];
---

<Base
  title="Integrate — Windgram"
  description="Consume the published forecast dataset: the data contract, and the windgram npm package's contract guards, derivations, scene graph, and reference SVG renderer."
  activeNav="docs"
>
  <main class="shell prose">
    <header class="docs-header">
      <h1>Integrate</h1>
      <p class="docs-lede">
        Everything this project publishes is static JSON with a versioned contract. The document
        shapes, units, and URLs are specified in the repository README's
        <a href="https://github.com/azohra/windgram#data-contract" target="_blank" rel="noopener"
          >data contract</a
        >, and
        <a
          href="https://raw.githubusercontent.com/azohra/windgram/main/data/models.json"
          target="_blank"
          rel="noopener"><code>data/models.json</code></a
        >
        is the machine-readable model catalogue consumers discover from. The guide below is the
        <code>windgram</code> npm package's README, rendered straight from the repository.
      </p>
    </header>

    <Fragment set:html={intro} />
    <DocToc toc={doc.toc} />
    <Fragment set:html={body} />
  </main>
</Base>

<style>
  .docs-header {
    position: relative;
    padding: 54px 0 26px;
    margin-bottom: 26px;
    border-bottom: 1px solid var(--rule-strong);
  }
  .docs-header::after {
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 116px;
    height: 4px;
    background: var(--accent);
    content: "";
  }
  .docs-header h1 {
    margin: 0 0 14px;
    font-size: clamp(48px, 6vw, 68px);
    line-height: 0.95;
  }
  .docs-lede {
    max-width: 790px;
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  @media (max-width: 680px) {
    .docs-header {
      padding-top: 38px;
    }
    .docs-header h1 {
      font-size: 46px;
    }
  }
</style>
