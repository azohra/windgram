---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import ModelCompareGrid from "../../../components/research/ModelCompareGrid.astro";
import { referenceDocs, splitBeforeHeading } from "../../../lib/research";

const doc = referenceDocs().find(({ slug }) => slug === "forecast-model-feeds");
if (!doc) throw new Error("Forecast model feed reference is not registered");

// Starlight owns the page H1. The living reference keeps its H1 because the
// same source must remain complete when rendered directly on GitHub.
const articleHtml = doc.html.replace(/^<h1[^>]*>[\s\S]*?<\/h1>\s*/, "");
const [intro, body] = splitBeforeHeading(articleHtml, "hrdps-continental-25-km-supported");
const headings = doc.toc.map(({ id, text }) => ({ depth: 2 as const, slug: id, text }));
---

<StarlightPage
  frontmatter={{
    title: doc.title,
    description: doc.dek,
    editUrl: "https://github.com/azohra/windgram/edit/main/reference/forecast-model-feeds.md",
  }}
  headings={headings}
>
  <Fragment set:html={intro} />
  <ModelCompareGrid />
  <Fragment set:html={body} />
</StarlightPage>
