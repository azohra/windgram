---
import {
  CANADARASP_RAMP,
  CLASS_LABELS,
  CLASS_NAMES,
  DEFAULT_RAMP,
  oklabLightness,
} from "./ramp-math";

/* OKLCH lightness per class for both palettes, computed at build time from
   the imported hexes: the default is a strictly descending staircase — the
   order is the encoding — while the canadarasp preset's lightness rises and
   falls, because its palette carries identity, not order. */

const LEFT = 96;
const RIGHT = 992;
const TOP = 64;
const BOTTOM = 344;
const L_MAX = 0.9;
const L_MIN = 0.3;

const x = (index: number) => LEFT + (index * (RIGHT - LEFT)) / 7;
const y = (lightness: number) => TOP + ((L_MAX - lightness) / (L_MAX - L_MIN)) * (BOTTOM - TOP);

const series = [
  { ...DEFAULT_RAMP, css: "sl-default" },
  { ...CANADARASP_RAMP, css: "sl-canadarasp" },
].map((ramp) => {
  const lightness = ramp.hexes.map(oklabLightness);
  return {
    ...ramp,
    lightness,
    points: lightness.map((value, i) => ({ x: x(i), y: y(value), value })),
    monotone: lightness.every((value, i) => i === 0 || value < lightness[i - 1]),
  };
});

const ticks = [0.3, 0.4, 0.5, 0.6, 0.7, 0.8, 0.9];
const labelLines = CLASS_NAMES.map((name) =>
  (CLASS_LABELS[name] ?? name).replace(" · ", " ").split(" "),
);

const description = series
  .map(
    (ramp) =>
      `${ramp.name}: lightness ${ramp.lightness.map((value) => value.toFixed(3)).join(", ")}` +
      (ramp.monotone ? " — strictly decreasing." : " — not monotone."),
  )
  .join(" ");
---

<figure class="ramp-lightness" aria-labelledby="ramp-lightness-title ramp-lightness-caption">
  <header>
    <h3 id="ramp-lightness-title">Lightness carries the order — or it doesn't</h3>
    <span>OKLCH lightness per class, computed at build time from the imported palettes.</span>
  </header>

  <div class="graphic-scroll" tabindex="0" aria-label="Scrollable chart of per-class lightness for both palettes">
    <svg viewBox="0 0 1040 432" role="img" aria-labelledby="ramp-lightness-svg-title ramp-lightness-svg-desc">
      <title id="ramp-lightness-svg-title">
        Per-class OKLCH lightness of the default stability ramp and the canadarasp preset
      </title>
      <desc id="ramp-lightness-svg-desc">
        Eight stability classes from very unstable to strong inversion, left to right, against
        lightness from 0.3 to 0.9. {description}
      </desc>

      <g class="sl-grid" aria-hidden="true">
        {ticks.map((tick) => (
          <>
            <line x1={LEFT - 8} y1={y(tick)} x2={RIGHT} y2={y(tick)} />
            <text x={LEFT - 16} y={y(tick) + 4}>{tick.toFixed(1)}</text>
          </>
        ))}
      </g>
      <text x="24" y={TOP - 26} class="sl-axis-name">OKLCH lightness</text>

      <g class="sl-legend">
        <line x1="700" y1={TOP - 30} x2="726" y2={TOP - 30} class="sl-key sl-default" />
        <text x="734" y={TOP - 26}>{series[0].name}</text>
        <line x1="862" y1={TOP - 30} x2="888" y2={TOP - 30} class="sl-key sl-canadarasp" />
        <text x="896" y={TOP - 26}>{series[1].name}</text>
      </g>

      {series.map((ramp) => (
        <g>
          <polyline
            points={ramp.points.map((point) => `${point.x},${point.y}`).join(" ")}
            class={`sl-line ${ramp.css}`}
          />
          {ramp.points.map((point, index) => (
            <circle cx={point.x} cy={point.y} r="4.5" class={`sl-dot ${ramp.css}`}>
              <title>{`${ramp.name} — ${CLASS_LABELS[CLASS_NAMES[index]]}: L ${point.value.toFixed(3)}`}</title>
            </circle>
          ))}
        </g>
      ))}

      <text x={x(0) - 10} y={y(series[0].lightness[0]) - 12} class="sl-value">
        {series[0].lightness[0].toFixed(2)}
      </text>
      <text x={x(7)} y={y(series[0].lightness[7]) + 24} class="sl-value">
        {series[0].lightness[7].toFixed(2)}
      </text>

      {labelLines.map((lines, column) =>
        lines.map((line, lineIndex) => (
          <text
            x={x(column)}
            y={BOTTOM + 24 + lineIndex * 12}
            class="sl-colhead"
          >
            {line}
          </text>
        )),
      )}
    </svg>
  </div>

  <figcaption id="ramp-lightness-caption">
    The default ramp descends strictly — every class darker than the one before, so grayscale,
    print, and colour-deficient vision all keep the sequence. The canadarasp preset's zigzag is the
    signature of a categorical palette: identity by hue, order delegated to the legend.
  </figcaption>
</figure>

<style>
  .ramp-lightness {
    display: block;
    width: min(1040px, calc(100vw - 32px));
    margin: 28px 50% 44px;
    transform: translateX(-50%);
    color: var(--ink);
    border-top: 3px solid var(--accent);
    border-bottom: 1px solid var(--rule-strong);
  }
  header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px 24px;
    align-items: end;
    padding: 18px 0 16px;
  }
  .ramp-lightness h3 { margin: 0; font: 700 29px/1 var(--display); text-transform: uppercase; }
  header > span { font: 13px/1.4 var(--mono); color: var(--ink-mute); }
  .graphic-scroll {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    padding: 10px 10px 4px;
    scrollbar-color: var(--accent) var(--surface-raised);
  }
  .graphic-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  svg { display: block; width: 100%; min-width: 880px; height: auto; font-family: var(--mono); }
  .sl-grid line { stroke: var(--rule); stroke-width: 1; opacity: .45; }
  .sl-grid text { fill: var(--ink-mute); font-size: 11px; text-anchor: end; }
  .sl-axis-name { fill: var(--ink-mute); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .sl-legend text { fill: var(--ink-soft); font-size: 11.5px; }
  .sl-key { stroke-width: 3; }
  .sl-line { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  line.sl-default, .sl-line.sl-default { stroke: var(--model-1); }
  line.sl-canadarasp, .sl-line.sl-canadarasp { stroke: var(--model-2); }
  .sl-dot { stroke: var(--surface); stroke-width: 2; }
  .sl-dot.sl-default { fill: var(--model-1); }
  .sl-dot.sl-canadarasp { fill: var(--model-2); }
  .sl-value { fill: var(--ink); font-size: 11px; font-weight: 700; text-anchor: middle; paint-order: stroke; stroke: var(--surface); stroke-width: 2.4px; }
  .sl-colhead { fill: var(--ink-soft); font-size: 10px; font-weight: 700; text-anchor: middle; }
  figcaption { padding: 12px 0 14px; font: 12px/1.5 var(--mono); color: var(--ink-mute); }
  @media (max-width: 720px) {
    header { grid-template-columns: 1fr; }
    .ramp-lightness h3 { font-size: 25px; }
    header > span { font-size: 12px; }
    .graphic-scroll { margin-inline: -8px; }
  }
</style>
