---
import type { ResearchArticle } from "../../lib/research";

interface Props {
  doc: ResearchArticle;
}

const { doc } = Astro.props;
---

<div class={`article-meta accent-${doc.accent}`}>
  <span class="article-number">Entry {doc.number}</span>
  <span>{doc.section}</span>
  <span>{doc.readingMinutes} min read</span>
</div>

<style>
  .article-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 22px 0 16px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.065em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .article-meta span + span::before {
    content: "/";
    margin-right: 10px;
    color: var(--rule-strong);
  }
  /* .accent-* → --doc-accent is the one accent translation, in theme.css. */
  .article-number {
    color: var(--doc-accent);
  }
  @media (max-width: 520px) {
    .article-meta {
      flex-wrap: wrap;
      row-gap: 3px;
    }
  }
</style>
