---
import { DEFAULT_OVERLAYS, type OverlayName } from "windgram/scene";
import Figure from "../figure/Figure.astro";
import Legend from "../figure/Legend.astro";
import SyntheticWindgram from "../windgram/SyntheticWindgram.astro";
import WindgramAnnotations from "../windgram/WindgramAnnotations.astro";
import {
  onlyOverlays,
  renderSyntheticWindgram,
} from "../../lib/example-windgram";
import { scenarioById } from "../../lib/scenarios";

type WindgramView = "full" | "metrics" | "stability" | "lines";

interface Props {
  view?: WindgramView;
}

const { view = "full" } = Astro.props;
const scenario = scenarioById("convective-cycle");

const views: Record<WindgramView, {
  title: string;
  lesson: string;
  caption: string;
  overlays: Record<OverlayName, boolean>;
}> = {
  full: {
    title: "The convective cycle as a complete windgram",
    lesson: scenario.lesson,
    caption: "Every visible path and barb comes from the npm scene graph and SVG serializer; the surrounding readout is a website annotation over the same selected hour.",
    overlays: { ...DEFAULT_OVERLAYS },
  },
  metrics: {
    title: "Surface forcing changes through the cycle",
    lesson: "Pressure, cloud, precipitation, and thermal strength share time while retaining separate units and scales.",
    caption: "The package renderer isolates the surface strips and their companion cloud field from the same profile.",
    overlays: onlyOverlays("pressure", "precipitation", "clouds", "thermalStrength", "selectedHour"),
  },
  stability: {
    title: "Heating deepens a mixed layer",
    lesson: "Stability supplies the vertical structure while w* supplies the surface forcing that makes convection active.",
    caption: "The stability field, thermal-strength strip, and derived height lines show the same convective cycle.",
    overlays: onlyOverlays("stability", "thermalStrength", "boundaryLayerTop", "usableLiftTop", "launch", "selectedHour"),
  },
  lines: {
    title: "Three heights answer three different questions",
    lesson: "Usable lift, the parcel-derived boundary-layer top, and cloud base can separate or meet because they encode different limits.",
    caption: "The line geometry is serialized directly from the npm scene; this focused view changes visibility, not the scenario values.",
    overlays: onlyOverlays("boundaryLayerTop", "cloudBase", "usableLiftTop", "launch", "selectedHour"),
  },
};

const selectedView = views[view];
const id = `home-windgram-${view}`;
const idPrefix = `home-convective-cycle-${view}`;
const { scene } = renderSyntheticWindgram(
  scenario,
  { overlays: selectedView.overlays, columnWidthPx: 72, plotHeightPx: 390 },
  idPrefix,
);
---

<Figure
  {id}
  title={selectedView.title}
  lesson={selectedView.lesson}
  description={scenario.accessibilityDescription}
  caption={selectedView.caption}
  units="altitude m and ft · height lines m ASL · time UTC"
  {scenario}
>
  <WindgramAnnotations {scenario} {scene} mode={view === "lines" ? "lines" : "summary"} />
  <SyntheticWindgram
    {scenario}
    {idPrefix}
    overlays={selectedView.overlays}
    columnWidthPx={72}
    plotHeightPx={390}
  />
  {view === "lines" && (
    <Legend
      slot="legend"
      label="Height lines"
      items={[
        { label: "Usable lift", description: "Climb limit", color: "var(--chart-usable)" },
        { label: "Boundary layer", description: "Thermodynamic depth", color: "var(--chart-boundary)" },
        { label: "Cloud base", description: "Moisture limit", color: "var(--chart-cloud-base)" },
      ]}
    />
  )}
</Figure>
