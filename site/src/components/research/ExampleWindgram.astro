---
import { windgramProfileSchema } from "windgram/contract";
import { p50 } from "windgram/derive";

/* This component reads the fixed deterministic example document: every
   Scalar is a plain number, so its median is never null (full dropout is
   an ensemble-only shape). */
const med = (value: Parameters<typeof p50>[0]): number => p50(value)!;

import { DEFAULT_OVERLAYS, type OverlayName } from "windgram/scene";
import rawExample from "./forecast-example.json";
import {
  EXAMPLE_PROFILE,
  exampleOverlayAvailability,
  renderExample,
} from "../../lib/example-windgram";
import { modelBySlug } from "../../lib/catalogue";
import { DISPLAY_TZ, localHourLabel, runLabel } from "../../lib/time";

/* The field guide's teaching chart: the fixed Red Mountain document, drawn
   by the reference renderer at article scale, with every overlay the
   renderer knows switchable. The switchboard doubles as the chart's legend
   — each switch names a mark, the height switches carry the line's stroke
   sample, and flipping one removes exactly that mark. First paint is
   rendered at build time; the client script only re-renders on toggle, so
   the figure works (with defaults) before and without JavaScript. */

// The fixture must be a valid profile document by the package's own
// contract — drift fails the build, not the reader.
windgramProfileSchema.parse(rawExample);

const { scene, svg } = renderExample({});
const availability = exampleOverlayAvailability();

const modelLabel = modelBySlug(EXAMPLE_PROFILE.model)?.label ?? EXAMPLE_PROFILE.model;
const dayLabel = new Intl.DateTimeFormat("en-US", {
  timeZone: DISPLAY_TZ,
  weekday: "short",
  month: "short",
  day: "numeric",
  year: "numeric",
}).format(new Date(scene.hourValidAts[0]));

// Peak-hour readout, same wording rules as the compare page's app: gust
// phrasing follows the declared semantics (hour-max is an honest "gusting
// to"; an instantaneous diagnostic is not) — the document's own semantics
// tag first, the catalogue capability as the fallback for documents
// predating the tag.
const selectedValidAt = scene.hourValidAts[scene.selectedHourIndex];
const selectedHour = EXAMPLE_PROFILE.hours.find((hour) => hour.validAt === selectedValidAt)!;
const usableLift = med(selectedHour.derived.usableLiftTopM);
const gustMs = selectedHour.surface.windGustMs == null ? null : med(selectedHour.surface.windGustMs);
const gustSemantics =
  EXAMPLE_PROFILE.semantics?.gust ??
  (modelBySlug(EXAMPLE_PROFILE.model)?.capabilities.gust || undefined);
const gustText =
  gustMs == null || !gustSemantics
    ? null
    : `${gustSemantics === "hourMax" ? "gusting to" : "gusts"} ${Math.round(gustMs * 3.6)} km/h`;

/* The switchboard: every package overlay, grouped by what it draws. The
   coverage check below makes a new package overlay fail this build until
   the article's figure gives it a switch — the control panel cannot
   silently fall behind the renderer. */
interface Toggle {
  overlay: OverlayName;
  label: string;
  /** Stroke-sample chip for the four look-alike height lines. */
  chip?: "usable" | "boundary" | "cloud-base" | "pbl";
}
const GROUPS: { name: string; toggles: Toggle[] }[] = [
  {
    name: "Heights",
    toggles: [
      { overlay: "usableLiftTop", label: "Usable lift", chip: "usable" },
      { overlay: "boundaryLayerTop", label: "Boundary layer", chip: "boundary" },
      { overlay: "cloudBase", label: "Cloud base", chip: "cloud-base" },
      { overlay: "pblHeight", label: "Model PBL", chip: "pbl" },
    ],
  },
  {
    name: "Shading",
    toggles: [
      { overlay: "stability", label: "Stability" },
      { overlay: "clouds", label: "Cloud" },
      { overlay: "thermalIndex", label: "Thermal index" },
      { overlay: "windShear", label: "Wind shear" },
      { overlay: "relativeHumidity", label: "Humidity" },
      { overlay: "verticalVelocity", label: "Vertical velocity" },
    ],
  },
  {
    name: "Contours",
    toggles: [
      { overlay: "temperature", label: "Isotherms" },
      { overlay: "dewPoint", label: "Dew point" },
    ],
  },
  {
    name: "Wind",
    toggles: [
      { overlay: "wind", label: "Barbs" },
      { overlay: "gusts", label: "Gusts" },
    ],
  },
  {
    name: "Strips",
    toggles: [
      { overlay: "pressure", label: "Pressure" },
      { overlay: "precipitation", label: "Precip" },
      { overlay: "cape", label: "CAPE" },
      { overlay: "cloudLayers", label: "Cloud layers" },
      { overlay: "thermalStrength", label: "w* thermal" },
      { overlay: "buoyancyShear", label: "B/S ratio" },
    ],
  },
  {
    name: "Marks",
    toggles: [
      { overlay: "launch", label: "Launch line" },
      { overlay: "selectedHour", label: "Best hour" },
    ],
  },
];

const covered = GROUPS.flatMap((group) => group.toggles.map((toggle) => toggle.overlay));
const overlayNames = Object.keys(DEFAULT_OVERLAYS) as OverlayName[];
if (
  covered.length !== overlayNames.length ||
  overlayNames.some((name) => !covered.includes(name))
) {
  throw new Error(
    "ExampleWindgram switchboard must cover every package overlay exactly once — the renderer grew a toggle this figure doesn't offer.",
  );
}
---

<figure class="example-windgram">
  <div class="instrument-label">
    <span>Fixed forecast document</span>
    <strong>{EXAMPLE_PROFILE.site.name} · {modelLabel}</strong>
    <span>{dayLabel} · run {runLabel(EXAMPLE_PROFILE.run.referenceTime)}</span>
  </div>

  <div class="hour-readout">
    <strong>{localHourLabel(selectedValidAt)}:00</strong>
    <span>{Math.round(med(selectedHour.surface.temperatureC))} °C</span>
    <span>
      w* {med(selectedHour.derived.thermalVelocityMs).toFixed(1)} m/s · usable lift{" "}
      {usableLift == null ? "none" : `${Math.round(usableLift).toLocaleString("en-CA")} m`}
    </span>
    {gustText && <span>{gustText}</span>}
    <span>cloud {Math.round(med(selectedHour.surface.cloudCoverPercent))}%</span>
  </div>

  <div class="switchboard">
    {
      GROUPS.map((group) => (
        <fieldset class="switch-group">
          <legend>{group.name}</legend>
          {group.toggles.map((toggle) => {
            const available = availability[toggle.overlay];
            return (
              <label class={available ? undefined : "unavailable"}>
                <input
                  type="checkbox"
                  data-overlay={toggle.overlay}
                  checked={available && DEFAULT_OVERLAYS[toggle.overlay]}
                  disabled={!available}
                  autocomplete="off"
                />
                {toggle.chip && <i class={`chip chip-${toggle.chip}`} aria-hidden="true" />}
                <span>{toggle.label}</span>
                {!available && <em class="absent">absent</em>}
                {!available && (
                  <span class="sr-only">— this model publishes no such field in this document</span>
                )}
              </label>
            );
          })}
        </fieldset>
      ))
    }
  </div>

  <div class="chart-scroll" tabindex="0" aria-label="Scrollable windgram chart">
    <div class="chart-mount" set:html={svg} />
  </div>

  <figcaption>
    <p>
      One fixed {modelLabel} document, drawn by the reference renderer — the same numbers every
      section of this entry reads. Flip a switch to isolate a mark; a greyed switch names a field
      this model does not publish.
    </p>
    <div class="stability-legend">
      <span class="stability-title">stability</span>
      <span class="stability-end">unstable</span>
      <span class="swatches" aria-hidden="true">
        <i class="very-unstable"></i><i class="unstable"></i><i class="conditional-strong"></i><i
          class="conditional"></i>
        <i class="near-neutral"></i><i class="stable"></i><i class="inverted"></i><i
          class="strong-inversion"></i>
      </span>
      <span class="stability-end">inverted</span>
    </div>
  </figcaption>
</figure>

<script>
  import { DEFAULT_OVERLAYS, type OverlayName } from "windgram/scene";
  import { renderExample } from "../../lib/example-windgram";

  for (const root of document.querySelectorAll<HTMLElement>(".example-windgram")) {
    const mount = root.querySelector<HTMLElement>(".chart-mount");
    if (!mount) continue;
    const state: Partial<Record<OverlayName, boolean>> = { ...DEFAULT_OVERLAYS };
    const rerender = () => {
      mount.innerHTML = renderExample(state).svg;
    };
    let restored = false;
    for (const input of root.querySelectorAll<HTMLInputElement>("input[data-overlay]")) {
      const name = input.dataset.overlay as OverlayName;
      // A browser restoring form state (back/forward cache) can desync the
      // checkboxes from the build-time default render — resync once.
      if (!input.disabled && input.checked !== state[name]) {
        state[name] = input.checked;
        restored = true;
      }
      input.addEventListener("change", () => {
        state[name] = input.checked;
        rerender();
      });
    }
    if (restored) rerender();
  }
</script>

<style>
  .example-windgram {
    width: min(1100px, calc(100vw - 32px));
    margin: 30px 50% 46px;
    transform: translateX(-50%);
    background: var(--surface);
    border: 1px solid var(--rule);
    border-top: 3px solid var(--chart-wind);
    box-shadow: 0 18px 42px rgb(81 72 62 / 0.1);
  }
  .instrument-label {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 15px 10px;
    border-bottom: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .instrument-label strong {
    color: var(--ink);
  }
  .hour-readout {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    padding: 10px 15px;
    border-bottom: 1px solid var(--rule);
    background: var(--surface-raised);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-soft);
  }
  .hour-readout strong {
    color: var(--accent);
    font-size: 13px;
  }

  /* The switchboard: one labeled toggle bank per element family, reading
     like an instrument panel's legend plate. The switches ARE the legend —
     the height rows carry their line's stroke sample. */
  .switchboard {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--rule);
    background: color-mix(in srgb, var(--surface) 86%, var(--surface-raised));
  }
  .switch-group {
    flex: 1 0 auto;
    margin: 0;
    padding: 9px 16px 11px 14px;
    border: 0;
    border-right: 1px solid var(--rule);
  }
  .switch-group:last-child {
    border-right: 0;
  }
  .switch-group legend {
    padding: 0;
    margin-bottom: 3px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .switch-group label {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 2.5px 0;
    font-size: 13px;
    color: var(--ink-soft);
    white-space: nowrap;
    cursor: pointer;
  }
  .switch-group label:hover {
    color: var(--ink);
  }
  .switch-group input {
    width: 13px;
    height: 13px;
    margin: 0;
    accent-color: var(--accent);
  }
  .switch-group label.unavailable {
    color: var(--ink-mute);
    opacity: 0.55;
    cursor: default;
  }
  .absent {
    font-family: var(--mono);
    font-size: 10px;
    font-style: normal;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border: 1px solid var(--rule);
    padding: 0 4px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .chip {
    display: inline-block;
    flex: 0 0 22px;
    width: 22px;
    height: 0;
    border-top: 2.4px solid;
  }
  .chip-usable {
    border-color: var(--chart-usable);
  }
  .chip-boundary {
    border-color: var(--chart-boundary);
    border-top-style: dashed;
  }
  .chip-cloud-base {
    border-color: var(--chart-wind);
    border-top-style: dotted;
  }
  .chip-pbl {
    /* --wg-pbl is generated on :root from the package's TOKEN_DEFAULTS
       (Base.astro), so the chip reads the same hue the renderer draws. */
    border-color: var(--wg-pbl);
    border-top-style: dashed;
  }

  .chart-scroll {
    max-width: 100%;
    overflow-x: auto;
    background: var(--surface);
    scrollbar-color: var(--accent) var(--surface-raised);
  }
  .chart-scroll:focus-visible {
    outline-offset: -3px;
  }
  .chart-scroll :global(svg) {
    display: block;
    width: 100%;
    min-width: 940px;
    height: auto;
  }

  figcaption {
    display: grid;
    gap: 12px;
    padding: 13px 16px 15px;
    border-top: 1px solid var(--rule);
    background: color-mix(in srgb, var(--surface) 82%, var(--surface-raised));
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink-soft);
  }
  figcaption p {
    margin: 0;
    line-height: 1.55;
  }
  .stability-legend {
    display: grid;
    grid-template-columns: auto auto minmax(160px, 1fr) auto;
    align-items: center;
    gap: 10px 13px;
    padding-top: 11px;
    border-top: 1px solid var(--rule);
    color: var(--ink-mute);
  }
  .stability-title {
    color: var(--ink);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .stability-end {
    font-size: 11px;
  }
  .swatches {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    width: 100%;
    height: 12px;
    border: 1px solid var(--rule-strong);
  }
  .swatches i {
    display: block;
  }
  .swatches .very-unstable {
    background: var(--stab-very-unstable);
  }
  .swatches .unstable {
    background: var(--stab-unstable);
  }
  .swatches .conditional-strong {
    background: var(--stab-conditional-strong);
  }
  .swatches .conditional {
    background: var(--stab-conditional);
  }
  .swatches .near-neutral {
    background: var(--stab-near-neutral);
  }
  .swatches .stable {
    background: var(--stab-stable);
  }
  .swatches .inverted {
    background: var(--stab-inverted);
  }
  .swatches .strong-inversion {
    background: var(--stab-strong-inversion);
  }

  @media (max-width: 760px) {
    .example-windgram {
      width: calc(100vw - 24px);
    }
    .switch-group {
      flex: 1 0 46%;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .switch-group:last-child {
      border-bottom: 0;
    }
    .instrument-label span:last-child {
      display: none;
    }
    .stability-legend {
      grid-template-columns: auto 1fr auto;
    }
    .stability-title {
      grid-column: 1 / -1;
    }
  }
</style>
