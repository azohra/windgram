---
import { DEFAULT_OVERLAYS } from "windgram/scene";
import Figure from "../figure/Figure.astro";
import SyntheticWindgram from "../windgram/SyntheticWindgram.astro";
import WindgramAnnotations from "../windgram/WindgramAnnotations.astro";
import WindgramKey from "../windgram/WindgramKey.astro";
import WindgramLayerControls from "../windgram/WindgramLayerControls.astro";
import {
  overlayAvailability,
  renderSyntheticWindgram,
} from "../../lib/example-windgram";
import { scenarioById } from "../../lib/scenarios";

const scenario = scenarioById("convective-cycle");
const idPrefix = "example-convective-cycle";
const availability = overlayAvailability(scenario);
const { scene } = renderSyntheticWindgram(scenario, { overlays: {} }, idPrefix);
---

<Figure
  id="example-windgram"
  title="Read one complete convective cycle"
  lesson={scenario.lesson}
  description={scenario.accessibilityDescription}
  caption="A controlled, model-shaped teaching profile rendered by the npm package. Toggle layers to isolate an encoding; unavailable controls declare fields this scenario intentionally omits."
  units="altitude m and ft · wind km/h · temperature °C · pressure kPa · precipitation mm · w* m/s"
  {scenario}
  headingLevel="h2"
>
  <WindgramLayerControls
    slot="controls"
    {availability}
    overlays={DEFAULT_OVERLAYS}
  />

  <WindgramAnnotations {scenario} {scene} mode="summary" />
  <SyntheticWindgram
    {scenario}
    {idPrefix}
    interactive
    overlays={DEFAULT_OVERLAYS}
    columnWidthPx={78}
    plotHeightPx={430}
  />

  <WindgramKey
    slot="legend"
    {scene}
    chartIdPrefix={idPrefix}
    scrollLabel="Scrollable key for the complete windgram"
  />
</Figure>
