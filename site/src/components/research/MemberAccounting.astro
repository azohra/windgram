---
import { analyzeProfile } from "windgram/analyze";
import { isEnsembleValue } from "windgram/contract";
import Figure from "../figure/Figure.astro";
import { scenarioById } from "../../lib/scenarios";

const scenario = scenarioById("ensemble-column-censored");
const hour = scenario.profile.hours[0];
const boundary = hour.derived.boundaryLayerTopM;
if (boundary === null || !isEnsembleValue(boundary)) throw new Error("ensemble-column-censored must publish an ensemble boundary-layer top");
if (boundary.p10 === null || boundary.p50 === null || boundary.p90 === null) {
  throw new Error("ensemble-column-censored must publish populated boundary-layer percentiles");
}

const analysis = analyzeProfile(scenario.profile);
const membership = analysis.findings.find((finding) => finding.kind === "ensembleMembership");
if (!membership || membership.kind !== "ensembleMembership") {
  throw new Error("ensemble-column-censored must produce the package ensemble-membership finding");
}

const declaredMembers = membership.declaredMembers;
const members = Array.from({ length: declaredMembers }, (_, index) => index + 1);
const ceiledMembers = boundary.ceiledMembers ?? 0;
const resolved = boundary.members - ceiledMembers;
const missing = declaredMembers - boundary.members;
const metre = (value: number) => value.toLocaleString("en-CA", { maximumFractionDigits: 1 });
const p10 = boundary.p10;
const p50 = boundary.p50;
const p90 = boundary.p90;
---

<Figure
  id="member-accounting"
  title="Count contributors before reading a percentile"
  lesson="A percentile block says how many members contributed and how many reached the published column ceiling."
  description={`${declaredMembers} ensemble members contribute to the selected boundary-layer value; ${ceiledMembers} are column-ceiled and ${missing} are absent. The published p10, p50, and p90 are ${metre(p10)}, ${metre(p50)}, and ${metre(p90)} metres.`}
  caption="Counts and percentile values come directly from the validated ensemble scenario. windgram/analyze supplies the declared membership context; absent member values stay absent."
  units="member counts · altitude m ASL"
  {scenario}
>
  <div class="accounting-flow">
    <section>
      <span class="step">01</span>
      <h4>Declared members</h4>
      <div class="member-grid" role="img" aria-label={`${declaredMembers} declared members`}>
        {members.map((member) => <i aria-hidden="true">{member}</i>)}
      </div>
      <strong>{declaredMembers}</strong>
      <p>Run membership from the profile and the package analysis envelope.</p>
    </section>
    <section>
      <span class="step">02</span>
      <h4>Position accounting</h4>
      <dl>
        <div><dt>Resolved</dt><dd>{resolved}</dd></div>
        <div><dt>Ceiled</dt><dd>{ceiledMembers}</dd></div>
        <div><dt>Absent</dt><dd>{missing}</dd></div>
      </dl>
      <p>Ceiled values are lower bounds. Absent values never enter the ranking as zero.</p>
    </section>
    <section>
      <span class="step">03</span>
      <h4>Conditional distribution</h4>
      <dl>
        <div><dt>p10</dt><dd>{metre(p10)} m</dd></div>
        <div><dt>p50</dt><dd>{metre(p50)} m</dd></div>
        <div><dt>p90</dt><dd>{metre(p90)} m</dd></div>
      </dl>
      <p>These magnitudes describe the contributing members, not a calibrated probability.</p>
    </section>
  </div>
</Figure>

<style>
  .accounting-flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--surface); }
  section { min-width: 0; padding: 16px; }
  section + section { border-left: 1px solid var(--rule); }
  .step { color: var(--accent-strong); font: 700 11px/1 var(--mono); letter-spacing: .08em; }
  h4 { margin: 6px 0 14px; color: var(--ink); font: 700 16px/1.2 var(--sans); }
  .member-grid { display: grid; grid-template-columns: repeat(3, 32px); gap: 6px; margin-bottom: 10px; }
  .member-grid i { width: 32px; height: 32px; display: grid; place-items: center; color: var(--accent-ink); background: var(--accent); border-radius: 50%; font: 10px var(--mono); font-style: normal; }
  section > strong { color: var(--ink); font: 700 29px/1 var(--display); }
  dl { display: grid; gap: 7px; margin: 0 0 12px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 5px; border-bottom: 1px solid var(--rule); }
  dt, dd { font: 11px/1.3 var(--mono); }
  dt { color: var(--ink-mute); }
  dd { margin: 0; color: var(--ink); font-weight: 700; }
  p { margin: 9px 0 0; color: var(--ink-soft); font-size: 12px; line-height: 1.5; }
  @media (max-width: 680px) {
    .accounting-flow { grid-template-columns: 1fr; }
    section + section { border-left: 0; border-top: 1px solid var(--rule); }
  }
</style>
