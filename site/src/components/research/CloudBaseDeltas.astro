---
import Figure from "../figure/Figure.astro";

/* Old-versus-new deltas from the cloud-base change, per hour, for the two
   committed real columns. The values are the recorded measurement behind the
   entry's tables: both fixtures re-derived through pipeline/src/windgram/derive.py with
   the retired 121 m/°C estimate and with the Bolton LCL, everything else
   identical (the derivation's own tests pin the formulas; this figure only
   lays the measurement out). Geometry is computed at build time from the
   table below. */

interface HourDelta {
  /** UTC hour label, e.g. "19Z". */
  hour: string;
  /** cloudBaseM shift, new − old, metres. */
  cloudBase: number;
  /** usableLiftTopM shift, new − old, metres — only where it changed. */
  usableLift?: number;
  /** true when the old value was pinned at cloud base and the new one is a
      sink crossing below it. */
  decapped?: boolean;
}

interface Panel {
  name: string;
  hours: HourDelta[];
}

const PANELS: Panel[] = [
  {
    name: "HRDPS 2.5 km · Dundee",
    hours: [
      { hour: "14Z", cloudBase: 36.8 },
      { hour: "15Z", cloudBase: 40.1 },
      { hour: "16Z", cloudBase: 49.1 },
      { hour: "17Z", cloudBase: 51.0 },
      { hour: "18Z", cloudBase: 53.7 },
      { hour: "19Z", cloudBase: 55.9, usableLift: -479.5, decapped: true },
      { hour: "20Z", cloudBase: 58.2, usableLift: -99.1, decapped: true },
      { hour: "21Z", cloudBase: 55.3, usableLift: 55.3 },
      { hour: "22Z", cloudBase: 46.4 },
      { hour: "23Z", cloudBase: 38.6 },
      { hour: "00Z", cloudBase: 38.5 },
      { hour: "01Z", cloudBase: 38.0 },
      { hour: "02Z", cloudBase: 42.1 },
      { hour: "03Z", cloudBase: 37.8 },
      { hour: "04Z", cloudBase: 34.9 },
    ],
  },
  {
    name: "HRRR CONUS · Red Mtn",
    hours: [
      { hour: "19Z", cloudBase: 36.3 },
      { hour: "20Z", cloudBase: 42.1 },
      { hour: "21Z", cloudBase: 45.9 },
      { hour: "22Z", cloudBase: 49.4, usableLift: 49.4 },
      { hour: "23Z", cloudBase: 51.1 },
      { hour: "00Z", cloudBase: 49.0 },
      { hour: "01Z", cloudBase: 46.1 },
      { hour: "02Z", cloudBase: 44.5 },
      { hour: "03Z", cloudBase: 41.7 },
      { hour: "04Z", cloudBase: 41.6 },
    ],
  },
];

const SLOT = 33;
const PANEL_GAP = 44;
const LEFT = 96;
const TOP = 64;
const PX_PER_M = 0.52;
const MAX_VALUE = 80;
const MIN_VALUE = -500;

const y = (metres: number) => TOP + (MAX_VALUE - metres) * PX_PER_M;
const ZERO = y(0);
const BOTTOM = y(MIN_VALUE);

const panelX = (index: number) =>
  LEFT + PANELS.slice(0, index).reduce((sum, panel) => sum + panel.hours.length * SLOT, 0) + index * PANEL_GAP;
const WIDTH = panelX(PANELS.length) - PANEL_GAP + 24;

const BAR = 12;
const GAP = 2;

/* 4px-rounded data end, square at the zero baseline — for either sign. */
const barPath = (left: number, value: number) => {
  const end = y(value);
  const r = Math.min(4, Math.abs(ZERO - end) / 2);
  if (value >= 0) {
    return `M ${left} ${ZERO} L ${left} ${end + r} Q ${left} ${end} ${left + r} ${end} L ${left + BAR - r} ${end} Q ${left + BAR} ${end} ${left + BAR} ${end + r} L ${left + BAR} ${ZERO} Z`;
  }
  return `M ${left} ${ZERO} L ${left} ${end - r} Q ${left} ${end} ${left + r} ${end} L ${left + BAR - r} ${end} Q ${left + BAR} ${end} ${left + BAR} ${end - r} L ${left + BAR} ${ZERO} Z`;
};

const ticks = [50, 0, -100, -200, -300, -400, -500];

const description = PANELS.map(
  (panel) =>
    `${panel.name}: cloud base rises ${Math.min(...panel.hours.map((h) => h.cloudBase)).toFixed(1)} to ` +
    `${Math.max(...panel.hours.map((h) => h.cloudBase)).toFixed(1)} m; usable-lift changes ` +
    (panel.hours.some((h) => h.usableLift !== undefined)
      ? panel.hours
          .filter((h) => h.usableLift !== undefined)
          .map((h) => `${h.hour} ${h.usableLift! > 0 ? "+" : ""}${h.usableLift!.toFixed(1)} m${h.decapped ? " (de-capped)" : ""}`)
          .join(", ")
      : "none") +
    ".",
).join(" ");
---

<Figure
  id="cloud-base-deltas"
  title="What the exact cloud base moved"
  lesson="Metres of change per forecast hour, new − old, both committed real columns."
  description={description}
  caption="Every hour's cloud base rises 35–58 m — Bolton against the retired linear estimate, on dry columns where the saturated-layer floor never fires. The two rust bars falling far below zero are the de-capped hours: usable lift previously published at cloud base, now published at the sink crossing the cap had concealed. Fixed archived measurement over the committed HRDPS and HRRR fixture columns."
  units="Δ metres · hours UTC"
>
  <div class="wg-scroll wg-scroll--plate graphic-scroll" role="region" tabindex="0" aria-label="Scrollable chart of per-hour cloud-base and usable-lift changes">
    <svg viewBox={`0 0 ${WIDTH} 456`} role="img" aria-labelledby="cbd-svg-title cbd-svg-desc">
      <title id="cbd-svg-title">
        Per-hour change in published cloud base and usable-lift top after replacing the 121 m per degree
        estimate with the Bolton LCL
      </title>
      <desc id="cbd-svg-desc">{description}</desc>

      <g class="cbd-grid" aria-hidden="true">
        {ticks.map((tick) => (
          <>
            <line x1={LEFT - 8} y1={y(tick)} x2={WIDTH - 24} y2={y(tick)} class={tick === 0 ? "cbd-zero" : ""} />
            <text x={LEFT - 16} y={y(tick) + 4}>{tick > 0 ? `+${tick}` : tick}</text>
          </>
        ))}
      </g>
      <text x="24" y={TOP - 26} class="cbd-axis-name">Δ metres</text>

      <g class="cbd-legend">
        <rect x={WIDTH - 560} y={TOP - 40} width="14" height="14" class="cbd-bar cbd-cloudbase" />
        <text x={WIDTH - 538} y={TOP - 29}>cloud-base shift</text>
        <rect x={WIDTH - 380} y={TOP - 40} width="14" height="14" class="cbd-bar cbd-usable" />
        <text x={WIDTH - 358} y={TOP - 29}>usable-lift shift (where it changed)</text>
      </g>

      {PANELS.map((panel, panelIndex) => {
        const x0 = panelX(panelIndex);
        return (
          <g>
            <text x={x0} y={BOTTOM + 42} class="cbd-panel-name">{panel.name}</text>
            {panel.hours.map((hourDelta, hourIndex) => {
              const center = x0 + hourIndex * SLOT + SLOT / 2;
              const paired = hourDelta.usableLift !== undefined;
              const cloudLeft = paired ? center - BAR - GAP / 2 : center - BAR / 2;
              const usableLeft = center + GAP / 2;
              return (
                <g>
                  <path d={barPath(cloudLeft, hourDelta.cloudBase)} class="cbd-bar cbd-cloudbase">
                    <title>{`${panel.name} — ${hourDelta.hour}: cloud base +${hourDelta.cloudBase.toFixed(1)} m`}</title>
                  </path>
                  {paired && (
                    <path d={barPath(usableLeft, hourDelta.usableLift!)} class="cbd-bar cbd-usable">
                      <title>
                        {`${panel.name} — ${hourDelta.hour}: usable-lift top ${hourDelta.usableLift! > 0 ? "+" : ""}${hourDelta.usableLift!.toFixed(1)} m${hourDelta.decapped ? " — de-capped: the old value was pinned at cloud base; the sink crossing sits lower" : ""}`}
                      </title>
                    </path>
                  )}
                  {hourDelta.decapped && (
                    <text x={usableLeft + BAR / 2} y={y(hourDelta.usableLift!) + 16} class="cbd-value">
                      {hourDelta.usableLift!.toFixed(1)}
                    </text>
                  )}
                  {hourIndex % 3 === 0 && (
                    <text x={center} y={BOTTOM + 20} class="cbd-colhead">{hourDelta.hour}</text>
                  )}
                </g>
              );
            })}
          </g>
        );
      })}
    </svg>
  </div>
</Figure>

<style>
  /* wg-scroll / wg-scroll--plate carry the scroll-region contract; the
     shared Figure frame owns header, caption, and breakout geometry. */
  .graphic-scroll {
    padding: 10px 10px 4px;
  }
  svg { display: block; width: 100%; min-width: 880px; height: auto; font-family: var(--mono); }
  .cbd-grid line { stroke: var(--rule); stroke-width: 1; opacity: .45; }
  .cbd-grid line.cbd-zero { stroke: var(--rule-strong); opacity: .9; }
  .cbd-grid text { fill: var(--ink-mute); font-size: 11px; text-anchor: end; }
  .cbd-axis-name { fill: var(--ink-mute); font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .cbd-panel-name { fill: var(--ink-soft); font-size: 11.5px; font-weight: 700; letter-spacing: .04em; }
  .cbd-legend text { fill: var(--ink-soft); font-size: 11.5px; }
  .cbd-bar.cbd-cloudbase { fill: var(--model-1); }
  .cbd-bar.cbd-usable { fill: var(--model-2); }
  .cbd-value { fill: var(--ink); font-size: 11px; font-weight: 700; text-anchor: middle; paint-order: stroke; stroke: var(--surface); stroke-width: 2.4px; }
  .cbd-colhead { fill: var(--ink-soft); font-size: 10px; font-weight: 700; text-anchor: middle; }
  @media (max-width: 720px) {
    .graphic-scroll { margin-inline: -8px; }
  }
</style>
