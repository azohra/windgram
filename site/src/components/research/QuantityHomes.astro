---
import Figure from "../figure/Figure.astro";

// The authority boundary as one picture: the pipeline card owns the stored
// derived core, the document is the interface, and the package owns pure
// functions and typed statements over published state.
---

<Figure
  id="quantity-homes"
  title="Authority across the document boundary"
  lesson="The pipeline publishes authoritative values; the package derives views and projections from the document."
  description="The pipeline derives stored quantities that need provider inputs or cross-run authority. The npm package derives pure functions, typed statements, and a parameterized usable-lift projection from the published document."
  caption="Authority declared by windgram/windgram.py and the windgram package exports."
  units="Conceptual ownership map; no numeric scale"
>
  <div class="graphic-scroll" role="region" tabindex="0" aria-label="Scrollable diagram of the pipeline, the published document, and the package">
    <svg viewBox="0 0 960 486" role="img" aria-labelledby="quantity-homes-svg-title quantity-homes-svg-desc">
      <title id="quantity-homes-svg-title">Authority across the document boundary</title>
      <desc id="quantity-homes-svg-desc">
        The pipeline (windgram/windgram.py) derives boundary-layer top, thermal velocity, cloud
        base, and the default usable-lift top, and writes the published schema-version-1 document once per run.
        The windgram npm package reads only that document and owns humidity conversions, lapse and
        stability, thermal index and shear, day windowing with the timezone as a parameter, typed
        single-profile analysis, a sink-rate projection from the published inputs, the 1-2-1 smoothing
        option, and the scene-to-SVG renderer.
      </desc>

      <!-- ================= left: the pipeline ================= -->
      <rect x="32" y="24" width="272" height="332" class="qh-card"/>
      <rect x="32" y="24" width="272" height="52" class="qh-card-head"/>
      <text x="48" y="47" class="qh-home">THE PIPELINE</text>
      <text x="48" y="64" class="qh-home-sub qh-mono">windgram/windgram.py · builders</text>

      <text x="48" y="102" class="qh-list-head qh-mono">OWNS THE DERIVED CORE</text>

      <path d="M48 122 l5 -5 5 5 -5 5 Z" class="qh-bullet-pipe"/>
      <text x="64" y="126" class="qh-item qh-mono">boundaryLayerTopM</text>
      <text x="64" y="141" class="qh-item-note">dry parcel / environment crossing</text>

      <path d="M48 170 l5 -5 5 5 -5 5 Z" class="qh-bullet-pipe"/>
      <text x="64" y="174" class="qh-item qh-mono">thermalVelocityMs · w*</text>
      <text x="64" y="189" class="qh-item-note">Deardorff scale: heat flux × depth</text>

      <path d="M48 218 l5 -5 5 5 -5 5 Z" class="qh-bullet-pipe"/>
      <text x="64" y="222" class="qh-item qh-mono">cloudBaseM</text>
      <text x="64" y="237" class="qh-item-note">Bolton LCL · saturated-layer floor</text>

      <path d="M48 266 l5 -5 5 5 -5 5 Z" class="qh-bullet-pipe"/>
      <text x="64" y="270" class="qh-item qh-mono">usableLiftTopM</text>
      <text x="64" y="285" class="qh-item-note">published 1.0 m/s sink crossing · cloud cap</text>

      <line x1="48" y1="308" x2="288" y2="308" class="qh-foot-rule"/>
      <text x="48" y="328" class="qh-foot">Uses provider context beyond the hour blocks:</text>
      <text x="48" y="342" class="qh-foot">GRIB fields · cross-run history; terrain is echoed in site.</text>

      <!-- ================= centre: the document ================= -->
      <path d="M380 74 h176 l24 24 v236 h-200 Z" class="qh-doc"/>
      <path d="M556 74 v24 h24 Z" class="qh-doc-fold"/>
      <text x="398" y="104" class="qh-list-head qh-mono">SCHEMAVERSION: 1</text>
      <text x="398" y="126" class="qh-item" font-size="14">The published document</text>
      <text x="398" y="142" class="qh-block-note qh-mono">data/&lt;model&gt;/sites/&lt;slug&gt;.json</text>

      <rect x="398" y="160" width="164" height="30" class="qh-block"/>
      <text x="406" y="173" class="qh-block-name qh-mono">surface</text>
      <text x="406" y="185" class="qh-block-note">SI units · fluxes included</text>

      <rect x="398" y="196" width="164" height="30" class="qh-block"/>
      <text x="406" y="209" class="qh-block-name qh-mono">levels</text>
      <text x="406" y="221" class="qh-block-note">per level · every hour</text>

      <rect x="398" y="232" width="164" height="30" class="qh-block-derived"/>
      <text x="406" y="245" class="qh-block-name qh-mono">derived</text>
      <text x="406" y="257" class="qh-block-note">four core values · unsmoothed</text>

      <rect x="398" y="268" width="164" height="30" class="qh-block"/>
      <text x="406" y="281" class="qh-block-name qh-mono">run · site</text>
      <text x="406" y="293" class="qh-block-note">referenceTime · coordinates</text>

      <text x="480" y="320" text-anchor="middle" class="qh-doc-tag qh-mono" font-size="9.5">THE ONLY INTERFACE BETWEEN HOMES</text>

      <!-- ================= right: the package ================= -->
      <rect x="656" y="24" width="272" height="332" class="qh-card"/>
      <rect x="656" y="24" width="272" height="52" class="qh-card-head"/>
      <text x="672" y="47" class="qh-home">THE PACKAGE</text>
      <text x="672" y="64" class="qh-home-sub qh-mono">npm windgram · six subpath exports</text>

      <text x="672" y="102" class="qh-list-head qh-mono">PURE FUNCTIONS + TYPED STATEMENTS</text>

      <circle cx="677" cy="120" r="4" class="qh-bullet-pkg"/>
      <text x="690" y="124" class="qh-item" font-size="12">humidity conversions</text>
      <circle cx="677" cy="148" r="4" class="qh-bullet-pkg"/>
      <text x="690" y="152" class="qh-item" font-size="12">lapse · shear · sink-rate projection</text>
      <circle cx="677" cy="176" r="4" class="qh-bullet-pkg"/>
      <text x="690" y="180" class="qh-item" font-size="12">analyze <tspan class="qh-item-note">— cited findings over one profile</tspan></text>
      <circle cx="677" cy="204" r="4" class="qh-bullet-pkg"/>
      <text x="690" y="208" class="qh-item" font-size="12">day windowing <tspan class="qh-item-note">— timezone a parameter</tspan></text>
      <circle cx="677" cy="232" r="4" class="qh-bullet-pkg"/>
      <text x="690" y="236" class="qh-item" font-size="12">smooth121 <tspan class="qh-item-note">— a renderer option</tspan></text>
      <circle cx="677" cy="260" r="4" class="qh-bullet-pkg"/>
      <text x="690" y="264" class="qh-item" font-size="12">scene graph → SVG renderer</text>

      <line x1="672" y1="300" x2="912" y2="300" class="qh-foot-rule"/>
      <text x="672" y="320" class="qh-foot">Consumers run it wherever the JSON reaches,</text>
      <text x="672" y="334" class="qh-foot">with thresholds, tokens, and windows kept downstream.</text>

      <!-- ================= flows ================= -->
      <path d="M304 196 H372" class="qh-flow" marker-end="url(#qh-head)"/>
      <text x="338" y="180" text-anchor="middle" class="qh-flow-label qh-mono">writes</text>
      <text x="338" y="216" text-anchor="middle" class="qh-flow-label qh-mono">per run</text>

      <path d="M588 196 H648" class="qh-flow" marker-end="url(#qh-head)"/>
      <text x="618" y="184" text-anchor="middle" class="qh-flow-label qh-mono">reads</text>

      <!-- ================= the rule ================= -->
      <rect x="32" y="390" width="896" height="72" class="qh-rule-band"/>
      <text x="56" y="433" class="qh-rule-word">THE RULE</text>
      <text x="196" y="420" class="qh-rule-text">Needs inputs beyond the published JSON, or cross-run authority <tspan class="qh-em">→ the pipeline.</tspan></text>
      <text x="196" y="442" class="qh-rule-text">A pure function of the published document <tspan class="qh-em">→ the package.</tspan>  No quantity lives in both.</text>

      <defs>
        <marker id="qh-head" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="6.5" markerHeight="6.5" orient="auto">
          <path d="M0 0 L10 5 L0 10 Z" class="qh-arrow"/>
        </marker>
      </defs>
    </svg>
  </div>

</Figure>

<style>
  .graphic-scroll {
    overflow-x: auto;
    background: var(--surface);
    border: 1px solid var(--rule);
    scrollbar-color: var(--accent) var(--surface-raised);
  }
  .graphic-scroll:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  svg { display: block; width: 100%; min-width: 840px; height: auto; }
  .qh-mono { font-family: var(--mono); }
  svg text { font-family: var(--sans); }
  svg text.qh-mono, svg tspan.qh-mono { font-family: var(--mono); }
  .qh-card { fill: var(--surface); stroke: var(--rule); }
  .qh-card-head { fill: var(--wg-strip-bg); stroke: var(--rule); }
  .qh-doc { fill: var(--surface); stroke: var(--rule-strong); stroke-width: 1.4; }
  .qh-doc-fold { fill: var(--surface-sunken); stroke: var(--rule-strong); stroke-width: 1.4; }
  .qh-home { fill: var(--ink); font-size: 16px; font-weight: 800; letter-spacing: .03em; }
  .qh-home-sub { fill: var(--ink-mute); font-size: 10.5px; }
  .qh-list-head { fill: var(--accent-strong); font-size: 10.5px; font-weight: 700; letter-spacing: .07em; }
  .qh-item { fill: var(--ink); font-size: 12.5px; font-weight: 700; }
  .qh-item-note { fill: var(--ink-mute); font-size: 10.5px; font-weight: 400; }
  .qh-bullet-pipe { fill: var(--accent); }
  .qh-bullet-pkg { fill: var(--chart-usable); }
  .qh-foot { fill: var(--ink-mute); font-size: 10px; }
  .qh-foot-rule { stroke: var(--rule); stroke-dasharray: 2 4; }
  .qh-block { fill: var(--wg-strip-bg); stroke: var(--rule); stroke-width: .7; }
  .qh-block-derived { fill: var(--surface-accent); stroke: var(--accent); stroke-width: .9; }
  .qh-block-name { fill: var(--ink); font-size: 11px; font-weight: 700; }
  .qh-block-note { fill: var(--ink-mute); font-size: 9.5px; }
  .qh-doc-tag { fill: var(--accent-strong); font-size: 10px; font-weight: 700; letter-spacing: .05em; }
  .qh-flow { stroke: var(--ink-soft); stroke-width: 1.6; fill: none; }
  .qh-flow-label { fill: var(--ink-mute); font-size: 10px; }
  .qh-arrow { fill: var(--ink-soft); }
  .qh-rule-band { fill: var(--surface-accent); stroke: var(--rule); }
  .qh-rule-word { fill: var(--accent-strong); font-family: var(--display); font-size: 19px; font-weight: 800; letter-spacing: .04em; }
  .qh-rule-text { fill: var(--ink); font-size: 13px; }
  .qh-em { font-weight: 700; }
</style>
