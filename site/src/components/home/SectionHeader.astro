---
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  titleId: string;
  align?: "left" | "split";
}

const { eyebrow, title, intro, titleId, align = "split" } = Astro.props;
---

<header class:list={["home-section-head", `home-section-head--${align}`]}>
  <div>
    <p class="home-section-head__eyebrow">{eyebrow}</p>
    <h2 id={titleId}>{title}</h2>
  </div>
  <p class="home-section-head__intro">{intro}</p>
</header>

<style>
  .home-section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(18rem, 1.1fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    align-items: end;
    margin-block-end: clamp(1.6rem, 4vw, 2.8rem);
    padding-block-end: 1.25rem;
    border-block-end: 1px solid var(--rule-strong);
  }

  .home-section-head--left {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
  }

  .home-section-head__eyebrow {
    margin: 0 0 0.55rem;
    color: var(--accent-strong);
    font: 700 0.72rem/1.4 var(--mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(2.15rem, 5vw, 4.35rem);
    line-height: 0.94;
  }

  .home-section-head__intro {
    max-width: 42rem;
    margin: 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.6vw, 1.13rem);
    line-height: 1.62;
  }

  @media (max-width: 44rem) {
    .home-section-head {
      grid-template-columns: 1fr;
      gap: 1rem;
      align-items: start;
    }
  }
</style>
