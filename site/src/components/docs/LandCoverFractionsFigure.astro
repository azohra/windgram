---
import type { LandCoverClass } from "windgram/contract";
import {
  CONTEXT_SITES,
  LAND_COVER_COLORS,
  LAND_COVER_LABELS,
  LAND_COVER_ORDER,
  sourceById,
} from "../../lib/site-context";
import Figure from "../figure/Figure.astro";

/* Generated from site-context.json at build time: per site, the
   land-cover composition of the 1 km and 3 km discs as stacked fraction
   bars, with the fragile single-pixel launch class printed beside them.
   The fractions are the thermal-catchment lesson — what the ground the
   thermals feed on is made of. */

const percent = (fraction: number) =>
  (fraction * 100).toLocaleString("en-CA", { maximumFractionDigits: 1 });

const sites = CONTEXT_SITES.map(({ site, context }) => ({
  site,
  atLaunch: context.landCover.atLaunch,
  discs: context.landCover.fractions.map((disc) => ({
    radiusKm: disc.radiusKm,
    segments: LAND_COVER_ORDER.filter(
      (landCoverClass) => disc.byClass[landCoverClass] !== undefined,
    ).map((landCoverClass) => ({
      landCoverClass,
      label: LAND_COVER_LABELS[landCoverClass],
      color: LAND_COVER_COLORS[landCoverClass],
      fraction: disc.byClass[landCoverClass] ?? 0,
    })),
  })),
}));

/* The legend lists only classes that actually appear at these sites. */
const presentClasses: LandCoverClass[] = LAND_COVER_ORDER.filter((landCoverClass) =>
  sites.some((entry) =>
    entry.discs.some((disc) =>
      disc.segments.some((segment) => segment.landCoverClass === landCoverClass),
    ),
  ),
);

const description = sites
  .map(({ site, atLaunch, discs }) => {
    const parts = discs.map(
      (disc) =>
        `within ${disc.radiusKm} km: ${disc.segments
          .map((segment) => `${segment.label} ${percent(segment.fraction)}%`)
          .join(", ")}`,
    );
    return `${site.name} (launch pixel ${LAND_COVER_LABELS[atLaunch]}): ${parts.join("; ")}.`;
  })
  .join(" ");
---

<Figure
  id="land-cover-fractions"
  title="What the thermal catchment is made of"
  lesson="Forest holds heat back; clearcut, rock, and grass release it; water kills it. The disc fractions carry that character — the single launch pixel does not."
  description={`Per-site land-cover composition from site-context.json. ${description}`}
  caption="Fractions are the share of each disc under a class, from ESA WorldCover 10 m (2021). A class absent from a bar is genuinely zero there — the map is wall-to-wall. The launch-pixel class is one 10 m pixel and is fragile: read it beside the 1 km bar, never alone."
  units="fraction of disc area % · disc radii km"
>
  <div class="lc-grid">
    {sites.map(({ site, atLaunch, discs }) => (
      <section class="lc-site">
        <header>
          <span class="lc-name">{site.name}</span>
          <span class="lc-at">
            launch pixel: <strong>{LAND_COVER_LABELS[atLaunch]}</strong>
          </span>
        </header>
        {discs.map((disc) => (
          <div class="lc-row">
            <span class="lc-radius">{disc.radiusKm} km</span>
            <div
              class="lc-bar"
              role="img"
              aria-label={`${site.name}, ${disc.radiusKm} km disc: ${disc.segments
                .map((segment) => `${segment.label} ${percent(segment.fraction)}%`)
                .join(", ")}`}
            >
              {disc.segments.map((segment) => (
                <i
                  style={`width:${segment.fraction * 100}%;background:${segment.color}`}
                  title={`${segment.label} ${percent(segment.fraction)}%`}
                >
                  {segment.fraction >= 0.08 && (
                    <span>{percent(segment.fraction)}%</span>
                  )}
                </i>
              ))}
            </div>
          </div>
        ))}
      </section>
    ))}
  </div>

  <div slot="legend" class="lc-legend">
    {presentClasses.map((landCoverClass) => (
      <span>
        <i
          class="lc-key"
          style={`background:${LAND_COVER_COLORS[landCoverClass]}`}
          aria-hidden="true"
        ></i>
        {LAND_COVER_LABELS[landCoverClass]}
      </span>
    ))}
  </div>

  <p class="catalogue-source">
    Generated from <code>site-context.json</code>. {sourceById("worldcover2021").attribution}.
  </p>
</Figure>

<style>
  .lc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; background: var(--surface); }
  .lc-site { min-width: 0; padding: 14px 16px 16px; border-bottom: 1px solid var(--rule); }
  .lc-site:nth-child(odd) { border-right: 1px solid var(--rule); }
  .lc-site:nth-last-child(-n + 2) { border-bottom: 0; }
  header { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 10px; }
  .lc-name { color: var(--ink); font: 700 17px/1.2 var(--display); text-transform: uppercase; letter-spacing: .01em; }
  .lc-at { color: var(--ink-mute); font: 10.5px/1.3 var(--mono); }
  .lc-at strong { color: var(--ink); font-weight: 700; }
  .lc-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .lc-row:last-child { margin-bottom: 0; }
  .lc-radius { flex: 0 0 38px; color: var(--ink-soft); font: 600 10.5px/1 var(--mono); text-align: right; }
  .lc-bar { display: flex; flex: 1 1 auto; height: 26px; overflow: hidden; border: 1px solid var(--rule-strong); }
  .lc-bar i { display: grid; place-items: center; min-width: 0; font-style: normal; }
  .lc-bar span { color: #fffdf8; font: 600 10px/1 var(--mono); text-shadow: 0 0 2px rgb(21 37 41 / 0.45); }
  .lc-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font: 11px/1.4 var(--mono); color: var(--ink-soft); }
  .lc-key { display: inline-block; width: 10px; height: 10px; margin-right: 5px; vertical-align: -1px; }
  .catalogue-source { margin: 0; padding: 9px 14px; color: var(--ink-mute); font: 11px/1.45 var(--mono); border-top: 1px solid var(--rule); }
  .catalogue-source code { font-family: var(--mono); }
  @media (max-width: 680px) {
    .lc-grid { grid-template-columns: 1fr; }
    .lc-site:nth-child(odd) { border-right: 0; }
    .lc-site:nth-last-child(-n + 2) { border-bottom: 1px solid var(--rule); }
    .lc-site:last-child { border-bottom: 0; }
  }
</style>
