---
import { CONTEXT_SITES, sourceById } from "../../lib/site-context";
import Figure from "../figure/Figure.astro";

/* Generated from site-context.json and sites.json at build time (the
   CapabilityMatrix single-source pattern): per site, the surveyed launch
   elevation, the best bare-earth lidar/DTM elevation, and the GLO-30
   surface-model elevation on one fine metre scale. The lesson is the
   agreement — three independent answers land within metres — while the
   weather model's own terrain (site.modelElevationM, live in every
   profile and deliberately not in the static file) sits far off this
   scale. */

const X0 = 300;
const X1 = 950;
const BLOCK_H = 128;
const LANE_DY = [40, 62, 84];

const format = (value: number) =>
  value.toLocaleString("en-CA", { maximumFractionDigits: 1 });
const delta = (value: number, surveyed: number) => {
  const difference = value - surveyed;
  return `${difference >= 0 ? "+" : "−"}${format(Math.abs(difference))} m`;
};

const blocks = CONTEXT_SITES.map(({ site, context }, index) => {
  const surveyed = site.elevationM;
  const glo30 = context.terrain.elevationM;
  const bareEarth = context.bareEarth ?? null;
  const values = [surveyed, glo30, ...(bareEarth ? [bareEarth.elevationM] : [])];

  // Domain: 5 m-rounded bounds with at least a 30 m span, so every site's
  // scale reads at comparable zoom.
  let lo = Math.floor((Math.min(...values) - 4) / 5) * 5;
  let hi = Math.ceil((Math.max(...values) + 4) / 5) * 5;
  while (hi - lo < 30) {
    lo -= 5;
    hi += 5;
  }
  const px = (metres: number) => X0 + ((metres - lo) / (hi - lo)) * (X1 - X0);
  const ticks: number[] = [];
  for (let tick = lo; tick <= hi; tick += 5) ticks.push(tick);

  const bareEarthSource = bareEarth ? sourceById(bareEarth.source) : null;
  const lanes = [
    { label: "surveyed launch", sub: "sites.json", value: surveyed, kind: "surveyed" },
    ...(bareEarth && bareEarthSource
      ? [
          {
            label: `bare earth · ${bareEarthSource.resolutionM} m`,
            sub: bareEarth.source,
            value: bareEarth.elevationM,
            kind: "bare-earth",
          },
        ]
      : []),
    { label: "GLO-30 surface", sub: "canopy included", value: glo30, kind: "surface" },
  ].map((lane, laneIndex) => ({
    ...lane,
    y: index * BLOCK_H + LANE_DY[laneIndex],
    x: px(lane.value),
    text:
      lane.kind === "surveyed"
        ? `${format(lane.value)} m`
        : `${format(lane.value)} m (${delta(lane.value, surveyed)})`,
  }));

  return {
    site,
    top: index * BLOCK_H,
    axisY: index * BLOCK_H + 104,
    surveyedX: px(surveyed),
    laneTop: index * BLOCK_H + LANE_DY[0] - 10,
    ticks: ticks.map((tick) => ({ value: tick, x: px(tick) })),
    lanes,
  };
});

const svgHeight = blocks.length * BLOCK_H + 8;

const description = blocks
  .map(({ site, lanes }) => {
    const parts = lanes.map((lane) => `${lane.label} ${lane.text}`);
    return `${site.name}: ${parts.join("; ")}.`;
  })
  .join(" ");

const attributions = ["glo30", "lidarbc", "mrdem30"].map(
  (id) => sourceById(id).attribution,
);
---

<Figure
  id="elevation-ladder"
  title="Three answers within metres — and one far away"
  lesson="Surveyed launch, bare-earth lidar, and the GLO-30 surface model agree within metres; a weather model's terrain does not."
  description={`Per-site elevation ladder on a fine metre scale. ${description} Each profile's site.modelElevationM — the weather model's smoothed terrain — is live data and typically sits tens to hundreds of metres off these scales.`}
  caption="Elevations are read from site-context.json and sites.json on every build. The weather model's own terrain is deliberately absent: it is live data — read site.modelElevationM from any profile and place it against this ladder yourself."
  units="elevation m MSL · deltas vs the surveyed launch"
>
  <div class="wg-scroll wg-scroll--plate graphic-scroll" role="region" tabindex="0" aria-label="Scrollable per-site elevation ladder">
    <svg
      viewBox={`0 0 1000 ${svgHeight}`}
      role="img"
      aria-labelledby="elevation-ladder-svg-title elevation-ladder-svg-desc"
    >
      <title id="elevation-ladder-svg-title">
        Surveyed, bare-earth, and GLO-30 elevations per site on a fine metre scale
      </title>
      <desc id="elevation-ladder-svg-desc">{description}</desc>

      {blocks.map(({ site, top, axisY, surveyedX, laneTop, ticks, lanes }) => (
        <g>
          <text x="24" y={top + 24} class="el-name">{site.name}</text>
          <text x="24" y={top + 40} class="el-name-sub">{site.slug}</text>

          <line x1={X0} y1={axisY} x2={X1} y2={axisY} class="el-axis" />
          {ticks.map((tick) => (
            <>
              <line x1={tick.x} y1={axisY} x2={tick.x} y2={axisY + 4} class="el-axis" />
              {tick.value % 10 === 0 && (
                <text x={tick.x} y={axisY + 16} class="el-axis-label">{tick.value}</text>
              )}
            </>
          ))}

          <line x1={surveyedX} y1={laneTop} x2={surveyedX} y2={axisY} class="el-ref" />

          {lanes.map((lane) => (
            <g>
              <text x="150" y={lane.y + 4} class="el-lane-label">{lane.label}</text>
              <text x="150" y={lane.y + 15} class="el-lane-sub">{lane.sub}</text>
              <line x1={X0} y1={lane.y} x2={X1} y2={lane.y} class="el-lane" />
              {lane.kind === "surveyed" ? (
                <path
                  d={`M ${lane.x} ${lane.y - 6} L ${lane.x + 6} ${lane.y} L ${lane.x} ${lane.y + 6} L ${lane.x - 6} ${lane.y} Z`}
                  class="el-surveyed"
                />
              ) : lane.kind === "bare-earth" ? (
                <circle cx={lane.x} cy={lane.y} r="5" class="el-bare" />
              ) : (
                <rect x={lane.x - 4.5} y={lane.y - 4.5} width="9" height="9" class="el-surface" />
              )}
              <text
                x={lane.x > X1 - 130 ? lane.x - 12 : lane.x + 12}
                y={lane.y + 4}
                text-anchor={lane.x > X1 - 130 ? "end" : "start"}
                class="el-value"
              >
                {lane.text}
              </text>
            </g>
          ))}
        </g>
      ))}
    </svg>
  </div>

  <div slot="legend" class="el-legend">
    <span><i class="el-key el-key--surveyed" aria-hidden="true"></i> surveyed launch</span>
    <span><i class="el-key el-key--bare" aria-hidden="true"></i> bare-earth DTM</span>
    <span><i class="el-key el-key--surface" aria-hidden="true"></i> GLO-30 surface (DSM)</span>
    <span class="el-legend-note">
      model terrain (<code>site.modelElevationM</code>): live per profile, off these scales
    </span>
  </div>

  <p class="catalogue-source">
    Generated from <code>site-context.json</code> and <code>sites.json</code>.
    {attributions.map((attribution) => (
      <span> {attribution}.</span>
    ))}
  </p>
</Figure>

<style>
  svg { display: block; width: 100%; min-width: 860px; height: auto; font-family: var(--mono); }
  .el-name { fill: var(--ink); font-family: var(--display); font-size: 17px; font-weight: 700; text-transform: uppercase; letter-spacing: .01em; }
  .el-name-sub { fill: var(--ink-mute); font-size: 10px; }
  .el-lane-label { fill: var(--ink-soft); font-size: 10.5px; font-weight: 600; }
  .el-lane-sub { fill: var(--ink-mute); font-size: 9px; }
  .el-lane { stroke: var(--rule); stroke-width: .6; opacity: .55; }
  .el-ref { stroke: var(--ink-mute); stroke-width: 1; stroke-dasharray: 2 3; }
  .el-axis { stroke: var(--rule-strong); stroke-width: 1; }
  .el-axis-label { fill: var(--ink-mute); font-size: 9.5px; text-anchor: middle; }
  .el-surveyed { fill: var(--ink); }
  .el-bare { fill: var(--model-1); }
  .el-surface { fill: var(--accent); }
  .el-value { fill: var(--ink); font-size: 10.5px; font-weight: 600; }
  .el-legend { display: flex; flex-wrap: wrap; gap: 6px 18px; align-items: center; font: 11px/1.4 var(--mono); color: var(--ink-mute); }
  .el-legend code { font-family: var(--mono); }
  .el-key { display: inline-block; width: 10px; height: 10px; margin-right: 5px; vertical-align: -1px; }
  .el-key--surveyed { background: var(--ink); transform: rotate(45deg); border-radius: 1px; }
  .el-key--bare { background: var(--model-1); border-radius: 50%; }
  .el-key--surface { background: var(--accent); }
  .el-legend-note { color: var(--ink-soft); }
  .catalogue-source { margin: 0; padding: 9px 14px; color: var(--ink-mute); font: 11px/1.45 var(--mono); border-top: 1px solid var(--rule); }
  .catalogue-source code { font-family: var(--mono); }
  @media (max-width: 720px) {
    .graphic-scroll { margin-inline: -8px; }
  }
</style>
