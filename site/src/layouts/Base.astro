---
import { STABILITY_TOKEN_DEFAULTS, TOKEN_DEFAULTS } from "windgram/svg";
import AttributionLine from "../components/AttributionLine.astro";
import SkylineMark from "../components/SkylineMark.astro";
import "@fontsource/big-shoulders/700.css";
import "@fontsource/big-shoulders/800.css";
import "@fontsource/big-shoulders/900.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "../styles/theme.css";

interface Props {
  title: string;
  description: string;
  activeNav?: "research" | "docs" | "about";
}

const { title, description, activeNav } = Astro.props;

// The package export is the stability ramp authority; the site's --stab-*
// custom properties (figure legends, StabilityGuide, HomeWindgram) are
// generated from it at build time instead of hand-mirroring hexes in CSS.
// The same pattern serves the package hues theme.css takes no position on
// but site chrome consumes (the switchboard's Model-PBL chip, the figures'
// cream cloud glyph): generated from TOKEN_DEFAULTS, never restated.
const stabilityTokens = Object.entries(STABILITY_TOKEN_DEFAULTS)
  .map(([name, hex]) => `--stab-${name}: ${hex};`)
  .join(" ");
const packageTokens = (["pbl", "cloud-marker"] as const)
  .map((name) => `--wg-${name}: ${TOKEN_DEFAULTS[name]};`)
  .join(" ");
const stabilityStyle = `:root { ${stabilityTokens} ${packageTokens} }`;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Same link-preview card the docs pages emit via the Starlight head
        (see astro.config.mjs) — non-docs pages render through this layout. */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://windgram.azohra.com/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Windgram — forecast profiles for soaring: the project wordmark beside a package-rendered windgram chart."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://windgram.azohra.com/social-card.png" />
    <style set:html={stabilityStyle}></style>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/">
        <SkylineMark />
        Windgram
      </a>
      <nav class="site-nav" aria-label="Project">
        <a href="/docs/" aria-current={activeNav === "docs" ? "page" : undefined}>Docs</a>
        <a href="/research/" aria-current={activeNav === "research" ? "page" : undefined}>Research</a>
        <a href="/about/" aria-current={activeNav === "about" ? "page" : undefined}>About</a>
        <a href="https://github.com/azohra/windgram">GitHub</a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <AttributionLine />
    </footer>
  </body>
</html>
