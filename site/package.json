{
  "name": "windgram-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir ../toolkit build && astro dev",
    "build": "pnpm --dir ../toolkit build && astro build",
    "preview": "astro preview",
    "check": "pnpm --dir ../toolkit build && astro check",
    "test": "pnpm run build && pnpm run test:built",
    "test:built": "playwright test"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/starlight": "^0.41.7",
    "@fontsource/big-shoulders": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.2.0",
    "windgram": "workspace:*"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
