{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic windgram scenario definition",
  "description": "A deterministic recipe for producing synthetic, model-shaped teaching data. Definitions contain source inputs and transformations only; pipeline-derived values are never authored here.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "lesson",
    "kind",
    "modelShape",
    "timeZone",
    "site",
    "clock",
    "baseline",
    "transforms",
    "semantics",
    "capabilities",
    "assertions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/slug"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "lesson": {
      "type": "string",
      "minLength": 20,
      "maxLength": 500
    },
    "kind": {
      "enum": [
        "deterministic",
        "ensemble",
        "comparison"
      ]
    },
    "modelShape": {
      "enum": [
        "hourly-rich",
        "hourly-core",
        "three-hourly-regional",
        "ensemble-five-level"
      ]
    },
    "timeZone": {
      "description": "An explicit IANA-style time-zone name. Machine-local aliases such as local or system are not accepted.",
      "type": "string",
      "pattern": "^(?:Etc/(?:UTC|GMT(?:[+-](?:[1-9]|1[0-4]))?)|[A-Za-z]+(?:[_-][A-Za-z]+)*(?:/[A-Za-z]+(?:[_-][A-Za-z]+)*)+)$"
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "clock": {
      "$ref": "#/$defs/clock"
    },
    "baseline": {
      "$ref": "#/$defs/baseline"
    },
    "transforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transform"
      }
    },
    "semantics": {
      "$ref": "#/$defs/semantics"
    },
    "capabilities": {
      "$ref": "#/$defs/capabilities"
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "ensemble": {
      "$ref": "#/$defs/ensemble"
    },
    "comparison": {
      "$ref": "#/$defs/comparison"
    },
    "physicalExceptions": {
      "description": "Narrowly-scoped exceptions used to exercise a physical edge case. Each exception requires a reason so it cannot be enabled accidentally.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "reason"
        ],
        "properties": {
          "type": {
            "const": "controlled-supersaturation"
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "maxLength": 300
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "ensemble"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "ensemble"
        ],
        "properties": {
          "modelShape": {
            "const": "ensemble-five-level"
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "ensemble"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "comparison"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "comparison"
        ]
      },
      "else": {
        "not": {
          "required": [
            "comparison"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "modelShape": {
            "const": "hourly-rich"
          }
        },
        "required": [
          "modelShape"
        ]
      },
      "then": {
        "properties": {
          "clock": {
            "properties": {
              "stepHours": {
                "const": 1
              }
            }
          },
          "capabilities": {
            "properties": {
              "levels": {
                "const": true
              },
              "heatFluxes": {
                "const": true
              },
              "gust": {
                "enum": [
                  "hourMax",
                  "instant"
                ]
              },
              "cape": {
                "const": true
              },
              "cin": {
                "const": true
              },
              "pblHeight": {
                "const": true
              },
              "cloudLayers": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "modelShape": {
            "const": "hourly-core"
          }
        },
        "required": [
          "modelShape"
        ]
      },
      "then": {
        "properties": {
          "clock": {
            "properties": {
              "stepHours": {
                "const": 1
              }
            }
          },
          "capabilities": {
            "properties": {
              "levels": {
                "const": true
              },
              "heatFluxes": {
                "const": true
              },
              "gust": {
                "const": false
              },
              "cape": {
                "const": false
              },
              "cin": {
                "const": false
              },
              "pblHeight": {
                "const": false
              },
              "cloudLayers": {
                "const": false
              },
              "cloudProfile": {
                "const": false
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "modelShape": {
            "const": "three-hourly-regional"
          }
        },
        "required": [
          "modelShape"
        ]
      },
      "then": {
        "properties": {
          "clock": {
            "properties": {
              "stepHours": {
                "const": 3
              }
            }
          },
          "capabilities": {
            "properties": {
              "pressureLevels": {
                "maxItems": 8
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "modelShape": {
            "const": "ensemble-five-level"
          }
        },
        "required": [
          "modelShape"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "ensemble"
          },
          "capabilities": {
            "properties": {
              "levels": {
                "const": true
              },
              "pressureLevels": {
                "minItems": 5,
                "maxItems": 5
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "gust": {
                "const": false
              }
            },
            "required": [
              "gust"
            ]
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "semantics": {
            "not": {
              "required": [
                "gust"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capabilities": {
            "properties": {
              "gust": {
                "enum": [
                  "hourMax",
                  "instant"
                ]
              }
            },
            "required": [
              "gust"
            ]
          }
        },
        "required": [
          "capabilities"
        ]
      },
      "then": {
        "properties": {
          "semantics": {
            "required": [
              "gust"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 80
    },
    "utcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "synthetic",
        "latitude",
        "longitude",
        "altitudeM",
        "modelElevationM"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "synthetic": {
          "const": true
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "altitudeM": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -500,
          "maximum": 9000
        },
        "modelElevationM": {
          "type": "number",
          "minimum": -500,
          "maximum": 9000
        }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "referenceTime",
        "generatedAt",
        "startAt",
        "stepHours",
        "hourCount",
        "seed"
      ],
      "properties": {
        "referenceTime": {
          "$ref": "#/$defs/utcInstant"
        },
        "generatedAt": {
          "$ref": "#/$defs/utcInstant"
        },
        "startAt": {
          "$ref": "#/$defs/utcInstant"
        },
        "stepHours": {
          "enum": [
            1,
            3
          ]
        },
        "hourCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 384
        },
        "seed": {
          "description": "The seed is mandatory even when the current recipe is deterministic, preventing later stochastic transforms from silently depending on ambient randomness.",
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "semantics": {
      "description": "Transport meaning for the synthetic source fields. This mirrors the published profile contract without claiming a production provider identity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precipitation"
      ],
      "properties": {
        "gust": {
          "enum": [
            "hourMax",
            "instant"
          ]
        },
        "precipitation": {
          "enum": [
            "instantRate",
            "windowMeanRate"
          ]
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "path"
      ],
      "properties": {
        "type": {
          "enum": [
            "synthetic",
            "calibrated"
          ]
        },
        "path": {
          "description": "Repository-local path, resolved from scenarios/. URLs and parent traversal are deliberately impossible.",
          "type": "string",
          "pattern": "^baselines/[a-z0-9]+(?:-[a-z0-9]+)*\\.source\\.json$"
        },
        "provenancePath": {
          "type": "string",
          "pattern": "^baselines/[a-z0-9]+(?:-[a-z0-9]+)*\\.provenance\\.json$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "calibrated"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "provenancePath"
            ]
          },
          "else": {
            "not": {
              "required": [
                "provenancePath"
              ]
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "levels",
        "pressureLevels",
        "verticalVelocity",
        "heatFluxes",
        "gust",
        "cape",
        "cin",
        "pblHeight",
        "cloudLayers",
        "cloudProfile"
      ],
      "properties": {
        "levels": {
          "type": "boolean"
        },
        "pressureLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 50,
            "maximum": 1100
          }
        },
        "verticalVelocity": {
          "oneOf": [
            {
              "const": false
            },
            {
              "enum": [
                "omega",
                "fromGeometricW"
              ]
            }
          ]
        },
        "verticalVelocityLevels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "number",
            "minimum": 50,
            "maximum": 1100
          }
        },
        "heatFluxes": {
          "type": "boolean"
        },
        "gust": {
          "oneOf": [
            {
              "const": false
            },
            {
              "enum": [
                "hourMax",
                "instant"
              ]
            }
          ]
        },
        "cape": {
          "type": "boolean"
        },
        "cin": {
          "type": "boolean"
        },
        "pblHeight": {
          "type": "boolean"
        },
        "cloudLayers": {
          "type": "boolean"
        },
        "cloudProfile": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "levels": {
                "const": false
              }
            },
            "required": [
              "levels"
            ]
          },
          "then": {
            "properties": {
              "pressureLevels": {
                "maxItems": 0
              },
              "verticalVelocity": {
                "const": false
              },
              "cloudProfile": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "pressureLevels": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verticalVelocity": {
                "const": false
              }
            },
            "required": [
              "verticalVelocity"
            ]
          },
          "then": {
            "not": {
              "required": [
                "verticalVelocityLevels"
              ]
            }
          },
          "else": {
            "required": [
              "verticalVelocityLevels"
            ]
          }
        }
      ]
    },
    "hourPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hourOffset",
        "value"
      ],
      "properties": {
        "hourOffset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "value": {
          "type": "number"
        }
      }
    },
    "scheduledNumber": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "byHour"
          ],
          "properties": {
            "byHour": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/hourPoint"
              }
            }
          }
        }
      ]
    },
    "hourSelection": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "altitudeBand": {
      "description": "An MSL band. The validator requires topM to be greater than bottomM.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bottomM",
        "topM"
      ],
      "properties": {
        "bottomM": {
          "type": "number",
          "minimum": -500,
          "maximum": 30000
        },
        "topM": {
          "type": "number",
          "minimum": -500,
          "maximum": 30000
        }
      }
    },
    "target": {
      "description": "A comparison variant id. It is omitted for deterministic and ensemble scenarios.",
      "$ref": "#/$defs/slug"
    },
    "surfaceField": {
      "enum": [
        "pressurePa",
        "temperatureC",
        "dewPointDepressionC",
        "windSpeedMs",
        "windDirectionDeg",
        "cloudCoverPercent",
        "precipitationMm",
        "sensibleHeatFluxWm2",
        "latentHeatFluxWm2",
        "windGustMs",
        "capeJkg",
        "cinJkg",
        "pblHeightM",
        "lowCloudPercent",
        "midCloudPercent",
        "highCloudPercent"
      ]
    },
    "optionalCapabilityField": {
      "enum": [
        "surface.windGustMs",
        "surface.capeJkg",
        "surface.cinJkg",
        "surface.pblHeightM",
        "surface.lowCloudPercent",
        "surface.midCloudPercent",
        "surface.highCloudPercent",
        "levels.verticalVelocityPaS",
        "levels.cloudFractionPercent"
      ]
    },
    "transform": {
      "oneOf": [
        {
          "$ref": "#/$defs/surfaceFieldCurve"
        },
        {
          "$ref": "#/$defs/temperatureOffset"
        },
        {
          "$ref": "#/$defs/dewPointDepressionOffset"
        },
        {
          "$ref": "#/$defs/windSpeedScale"
        },
        {
          "$ref": "#/$defs/windDirectionRotate"
        },
        {
          "$ref": "#/$defs/pressureTendency"
        },
        {
          "$ref": "#/$defs/capabilityField"
        },
        {
          "$ref": "#/$defs/timeShift"
        },
        {
          "$ref": "#/$defs/elevationAdjustment"
        }
      ]
    },
    "surfaceFieldCurve": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "field",
        "points"
      ],
      "properties": {
        "type": {
          "const": "surface-field-curve"
        },
        "field": {
          "$ref": "#/$defs/surfaceField"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hourPoint"
          }
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "temperatureOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altitudeBandM",
        "offsetC"
      ],
      "properties": {
        "type": {
          "const": "temperature-offset"
        },
        "altitudeBandM": {
          "$ref": "#/$defs/altitudeBand"
        },
        "offsetC": {
          "$ref": "#/$defs/scheduledNumber"
        },
        "atHours": {
          "$ref": "#/$defs/hourSelection"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "dewPointDepressionOffset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altitudeBandM",
        "offsetC"
      ],
      "properties": {
        "type": {
          "const": "dew-point-depression-offset"
        },
        "altitudeBandM": {
          "$ref": "#/$defs/altitudeBand"
        },
        "offsetC": {
          "$ref": "#/$defs/scheduledNumber"
        },
        "atHours": {
          "$ref": "#/$defs/hourSelection"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "windSpeedScale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altitudeBandM",
        "factor"
      ],
      "properties": {
        "type": {
          "const": "wind-speed-scale"
        },
        "altitudeBandM": {
          "$ref": "#/$defs/altitudeBand"
        },
        "factor": {
          "$ref": "#/$defs/scheduledNumber"
        },
        "includeSurface": {
          "type": "boolean",
          "default": false
        },
        "atHours": {
          "$ref": "#/$defs/hourSelection"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "windDirectionRotate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "altitudeBandM",
        "degrees"
      ],
      "properties": {
        "type": {
          "const": "wind-direction-rotate"
        },
        "altitudeBandM": {
          "$ref": "#/$defs/altitudeBand"
        },
        "degrees": {
          "$ref": "#/$defs/scheduledNumber"
        },
        "includeSurface": {
          "type": "boolean",
          "default": false
        },
        "atHours": {
          "$ref": "#/$defs/hourSelection"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "pressureTendency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "paPerHour"
      ],
      "properties": {
        "type": {
          "const": "pressure-tendency"
        },
        "paPerHour": {
          "type": "number"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "capabilityField": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field",
            "action",
            "value"
          ],
          "properties": {
            "type": {
              "const": "capability-field"
            },
            "field": {
              "$ref": "#/$defs/optionalCapabilityField"
            },
            "action": {
              "const": "add"
            },
            "value": {
              "$ref": "#/$defs/scheduledNumber"
            },
            "atHours": {
              "$ref": "#/$defs/hourSelection"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "field",
            "action"
          ],
          "properties": {
            "type": {
              "const": "capability-field"
            },
            "field": {
              "$ref": "#/$defs/optionalCapabilityField"
            },
            "action": {
              "const": "omit"
            },
            "atHours": {
              "$ref": "#/$defs/hourSelection"
            },
            "target": {
              "$ref": "#/$defs/target"
            }
          }
        }
      ]
    },
    "timeShift": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "hours"
      ],
      "properties": {
        "type": {
          "const": "time-shift"
        },
        "hours": {
          "type": "integer",
          "minimum": -240,
          "maximum": 240
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "elevationAdjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "elevation-adjustment"
        },
        "siteAltitudeDeltaM": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "modelElevationDeltaM": {
          "type": "number",
          "minimum": -5000,
          "maximum": 5000
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "anyOf": [
        {
          "required": [
            "siteAltitudeDeltaM"
          ]
        },
        {
          "required": [
            "modelElevationDeltaM"
          ]
        }
      ]
    },
    "metricField": {
      "oneOf": [
        {
          "$ref": "#/$defs/scalarMetricField"
        },
        {
          "$ref": "#/$defs/percentileMetricField"
        }
      ]
    },
    "scalarMetricField": {
      "enum": [
        "site.altitudeM",
        "site.modelElevationM",
        "surface.pressurePa",
        "surface.temperatureC",
        "surface.dewPointC",
        "surface.windSpeedMs",
        "surface.windDirectionDeg",
        "surface.cloudCoverPercent",
        "surface.precipitationMmHr",
        "surface.sensibleHeatFluxWm2",
        "surface.latentHeatFluxWm2",
        "surface.windGustMs",
        "surface.capeJkg",
        "surface.cinJkg",
        "surface.pblHeightM",
        "surface.lowCloudPercent",
        "surface.midCloudPercent",
        "surface.highCloudPercent",
        "levels.pressureHpa",
        "levels.heightM",
        "levels.temperatureC",
        "levels.dewPointC",
        "levels.windSpeedMs",
        "levels.windDirectionDeg",
        "levels.verticalVelocityPaS",
        "levels.cloudFractionPercent",
        "derived.boundaryLayerTopM",
        "derived.thermalVelocityMs",
        "derived.cloudBaseM",
        "derived.usableLiftTopM"
      ]
    },
    "percentileMetricField": {
      "description": "One position inside an ensemble percentile block: a field the ensemble aggregation ranks, with a trailing percentile key or `members`, the contributor count. Wind direction (circular median) and the level pressure coordinate publish plain numbers and take no suffix.",
      "type": "string",
      "pattern": "^(?:surface\\.(?:pressurePa|temperatureC|dewPointC|windSpeedMs|cloudCoverPercent|precipitationMmHr|sensibleHeatFluxWm2|latentHeatFluxWm2|windGustMs|capeJkg|cinJkg|pblHeightM|lowCloudPercent|midCloudPercent|highCloudPercent)|levels\\.(?:heightM|temperatureC|dewPointC|windSpeedMs)|derived\\.(?:boundaryLayerTopM|thermalVelocityMs|cloudBaseM|usableLiftTopM))\\.(?:p10|p25|p50|p75|p90|members)$"
    },
    "levelSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pressureHpa"
          ],
          "properties": {
            "pressureHpa": {
              "type": "number",
              "minimum": 50,
              "maximum": 1100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "nearestHeightM"
          ],
          "properties": {
            "nearestHeightM": {
              "type": "number",
              "minimum": -500,
              "maximum": 30000
            }
          }
        }
      ]
    },
    "metricRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/metricField"
        },
        "hour": {
          "type": "integer",
          "minimum": 0
        },
        "level": {
          "$ref": "#/$defs/levelSelector"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "pattern": "^levels\\."
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "required": [
              "hour",
              "level"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "pattern": "^(?:surface|derived)\\."
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "required": [
              "hour"
            ],
            "not": {
              "required": [
                "level"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "pattern": "^site\\."
              }
            },
            "required": [
              "field"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "hour"
                  ]
                },
                {
                  "required": [
                    "level"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "expectedValue": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/metricRef"
        }
      ]
    },
    "assertion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "description",
            "actual",
            "operator",
            "expected"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "description": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "actual": {
              "$ref": "#/$defs/metricRef"
            },
            "operator": {
              "enum": [
                "equal",
                "not-equal",
                "greater-than",
                "greater-than-or-equal",
                "less-than",
                "less-than-or-equal"
              ]
            },
            "expected": {
              "$ref": "#/$defs/expectedValue"
            },
            "tolerance": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "description",
            "actual",
            "operator"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "description": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "actual": {
              "$ref": "#/$defs/metricRef"
            },
            "operator": {
              "enum": [
                "present",
                "absent"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "description",
            "actual",
            "operator",
            "expected",
            "threshold"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/slug"
            },
            "description": {
              "type": "string",
              "minLength": 10,
              "maxLength": 300
            },
            "actual": {
              "$ref": "#/$defs/metricRef"
            },
            "operator": {
              "const": "absolute-difference-at-least"
            },
            "expected": {
              "$ref": "#/$defs/metricRef"
            },
            "threshold": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "ensembleSourceField": {
      "enum": [
        "surface.pressurePa",
        "surface.temperatureC",
        "surface.dewPointDepressionC",
        "surface.windSpeedMs",
        "surface.windDirectionDeg",
        "surface.cloudCoverPercent",
        "surface.precipitationMm",
        "surface.sensibleHeatFluxWm2",
        "surface.latentHeatFluxWm2",
        "levels.heightM",
        "levels.temperatureC",
        "levels.dewPointDepressionC",
        "levels.windSpeedMs",
        "levels.windDirectionDeg"
      ]
    },
    "ensemble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "members",
        "perturbations"
      ],
      "properties": {
        "members": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100
        },
        "perturbations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "distribution",
              "spread",
              "correlation"
            ],
            "properties": {
              "field": {
                "$ref": "#/$defs/ensembleSourceField"
              },
              "distribution": {
                "enum": [
                  "symmetric",
                  "normal",
                  "uniform"
                ]
              },
              "spread": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "correlation": {
                "enum": [
                  "independent",
                  "by-hour",
                  "by-level",
                  "whole-column"
                ]
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variants"
      ],
      "properties": {
        "variants": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/slug"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        }
      }
    }
  }
}
