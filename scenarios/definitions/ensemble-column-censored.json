{
  "$schema": "../scenario.schema.json",
  "schemaVersion": 1,
  "id": "ensemble-column-censored",
  "title": "A synthetic ensemble capped by its column",
  "lesson": "A deliberately shallow published column marks derived height members that reach the highest available level instead of presenting the ceiling as a resolved top.",
  "kind": "ensemble",
  "modelShape": "ensemble-five-level",
  "timeZone": "Etc/UTC",
  "site": {
    "id": "synthetic-ridge",
    "name": "Synthetic Ridge",
    "synthetic": true,
    "latitude": 49,
    "longitude": -123,
    "modelElevationM": 900
  },
  "launch": {
    "elevationM": 1050
  },
  "clock": {
    "referenceTime": "2000-01-01T06:00:00Z",
    "generatedAt": "2000-01-01T06:00:00Z",
    "startAt": "2000-01-01T12:00:00Z",
    "stepHours": 1,
    "hourCount": 6,
    "seed": 15003
  },
  "baseline": {
    "type": "synthetic",
    "path": "baselines/synthetic-five-level-day.source.json"
  },
  "transforms": [
    {
      "type": "surface-field-curve",
      "field": "temperatureC",
      "points": [
        {
          "hourOffset": 0,
          "value": 31
        },
        {
          "hourOffset": 5,
          "value": 31
        }
      ]
    },
    {
      "type": "surface-field-curve",
      "field": "dewPointDepressionC",
      "points": [
        {
          "hourOffset": 0,
          "value": 20
        },
        {
          "hourOffset": 5,
          "value": 20
        }
      ]
    },
    {
      "type": "surface-field-curve",
      "field": "sensibleHeatFluxWm2",
      "points": [
        {
          "hourOffset": 0,
          "value": 300
        },
        {
          "hourOffset": 5,
          "value": 300
        }
      ]
    }
  ],
  "semantics": {
    "precipitation": "instantRate"
  },
  "capabilities": {
    "levels": true,
    "pressureLevels": [
      925,
      850,
      800,
      700,
      600
    ],
    "verticalVelocity": false,
    "heatFluxes": true,
    "gust": false,
    "cape": false,
    "cin": false,
    "pblHeight": false,
    "cloudLayers": false,
    "cloudProfile": false
  },
  "ensemble": {
    "members": 9,
    "perturbations": [
      {
        "field": "surface.temperatureC",
        "distribution": "symmetric",
        "spread": 0.5,
        "correlation": "whole-column"
      },
      {
        "field": "surface.dewPointDepressionC",
        "distribution": "symmetric",
        "spread": 0.5,
        "correlation": "whole-column"
      },
      {
        "field": "levels.temperatureC",
        "distribution": "uniform",
        "spread": 0.4,
        "correlation": "by-level"
      },
      {
        "field": "levels.windDirectionDeg",
        "distribution": "uniform",
        "spread": 15,
        "correlation": "independent"
      }
    ]
  },
  "assertions": [
    {
      "id": "boundary-band-exists",
      "description": "The aggregate publishes the controlled boundary-layer height band.",
      "actual": {
        "field": "derived.boundaryLayerTopM",
        "hour": 2
      },
      "operator": "present"
    },
    {
      "id": "boundary-band-sits-at-the-column-ceiling",
      "description": "The censored boundary-layer median equals the highest published level's median height, not a resolved top.",
      "actual": {
        "field": "derived.boundaryLayerTopM.p50",
        "hour": 2
      },
      "operator": "equal",
      "expected": {
        "field": "levels.heightM.p50",
        "hour": 2,
        "level": {
          "pressureHpa": 600
        }
      },
      "tolerance": 0.5
    },
    {
      "id": "censored-band-has-no-spread",
      "description": "Members censored at the same ceiling collapse the boundary-layer p10-p90 band to that ceiling.",
      "actual": {
        "field": "derived.boundaryLayerTopM.p90",
        "hour": 2
      },
      "operator": "equal",
      "expected": {
        "field": "derived.boundaryLayerTopM.p10",
        "hour": 2
      },
      "tolerance": 0.5
    },
    {
      "id": "lift-band-exists",
      "description": "The aggregate publishes the controlled usable-lift height band.",
      "actual": {
        "field": "derived.usableLiftTopM",
        "hour": 2
      },
      "operator": "present"
    },
    {
      "id": "temperature-band-exists",
      "description": "The aggregate retains its source temperature percentile band.",
      "actual": {
        "field": "surface.temperatureC",
        "hour": 2
      },
      "operator": "present"
    }
  ]
}
