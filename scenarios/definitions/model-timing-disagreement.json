{
  "$schema": "../scenario.schema.json",
  "schemaVersion": 1,
  "id": "model-timing-disagreement",
  "title": "Two controlled development timings",
  "lesson": "Two synthetic profiles can express the same daytime development at different teaching hours, making timing differences visible without treating either profile as correct.",
  "kind": "comparison",
  "modelShape": "hourly-core",
  "timeZone": "Etc/UTC",
  "site": {
    "id": "synthetic-ridge",
    "name": "Synthetic Ridge",
    "synthetic": true,
    "latitude": 49,
    "longitude": -123,
    "altitudeM": 1050,
    "modelElevationM": 900
  },
  "clock": {
    "referenceTime": "2000-01-01T06:00:00Z",
    "generatedAt": "2000-01-01T06:00:00Z",
    "startAt": "2000-01-01T12:00:00Z",
    "stepHours": 1,
    "hourCount": 6,
    "seed": 15004
  },
  "baseline": {
    "type": "synthetic",
    "path": "baselines/synthetic-five-level-day.source.json"
  },
  "transforms": [
    {
      "type": "surface-field-curve",
      "target": "earlier",
      "field": "temperatureC",
      "points": [
        {"hourOffset": 0, "value": 23},
        {"hourOffset": 1, "value": 26},
        {"hourOffset": 2, "value": 29},
        {"hourOffset": 3, "value": 30},
        {"hourOffset": 4, "value": 28},
        {"hourOffset": 5, "value": 25}
      ]
    },
    {
      "type": "surface-field-curve",
      "target": "earlier",
      "field": "sensibleHeatFluxWm2",
      "points": [
        {"hourOffset": 0, "value": 120},
        {"hourOffset": 1, "value": 240},
        {"hourOffset": 2, "value": 320},
        {"hourOffset": 3, "value": 250},
        {"hourOffset": 4, "value": 130},
        {"hourOffset": 5, "value": 40}
      ]
    },
    {
      "type": "surface-field-curve",
      "target": "later",
      "field": "temperatureC",
      "points": [
        {"hourOffset": 0, "value": 18},
        {"hourOffset": 1, "value": 19},
        {"hourOffset": 2, "value": 21},
        {"hourOffset": 3, "value": 25},
        {"hourOffset": 4, "value": 28},
        {"hourOffset": 5, "value": 30}
      ]
    },
    {
      "type": "surface-field-curve",
      "target": "later",
      "field": "sensibleHeatFluxWm2",
      "points": [
        {"hourOffset": 0, "value": 20},
        {"hourOffset": 1, "value": 40},
        {"hourOffset": 2, "value": 100},
        {"hourOffset": 3, "value": 220},
        {"hourOffset": 4, "value": 320},
        {"hourOffset": 5, "value": 250}
      ]
    }
  ],
  "semantics": {
    "precipitation": "instantRate"
  },
  "capabilities": {
    "levels": true,
    "pressureLevels": [925, 850, 800, 700, 600],
    "verticalVelocity": false,
    "heatFluxes": true,
    "gust": false,
    "cape": false,
    "cin": false,
    "pblHeight": false,
    "cloudLayers": false,
    "cloudProfile": false
  },
  "comparison": {
    "variants": [
      {"id": "earlier", "title": "Earlier development"},
      {"id": "later", "title": "Later development"}
    ]
  },
  "assertions": [
    {
      "id": "earlier-warmer-first",
      "description": "The earlier profile is warmer during the second teaching hour.",
      "actual": {"field": "surface.temperatureC", "hour": 1, "target": "earlier"},
      "operator": "greater-than",
      "expected": {"field": "surface.temperatureC", "hour": 1, "target": "later"}
    },
    {
      "id": "earlier-deeper-first",
      "description": "The earlier profile has deeper boundary-layer development by the third teaching hour.",
      "actual": {"field": "derived.boundaryLayerTopM", "hour": 2, "target": "earlier"},
      "operator": "greater-than",
      "expected": {"field": "derived.boundaryLayerTopM", "hour": 2, "target": "later"}
    },
    {
      "id": "later-stronger-last",
      "description": "The later profile retains stronger thermal velocity at the final teaching hour.",
      "actual": {"field": "derived.thermalVelocityMs", "hour": 5, "target": "later"},
      "operator": "greater-than",
      "expected": {"field": "derived.thermalVelocityMs", "hour": 5, "target": "earlier"}
    }
  ]
}
