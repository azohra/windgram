{
  "$schema": "../scenario.schema.json",
  "schemaVersion": 1,
  "id": "persistent-inversion",
  "title": "A persistent inversion caps daytime heating",
  "lesson": "Strong surface heating is not enough to erase a warm cap, leaving the boundary layer below launch.",
  "kind": "deterministic",
  "modelShape": "hourly-core",
  "timeZone": "Etc/UTC",
  "site": {
    "id": "synthetic-capped-launch",
    "name": "Synthetic Capped Launch",
    "synthetic": true,
    "latitude": 49,
    "longitude": -123,
    "modelElevationM": 900
  },
  "launch": {
    "elevationM": 1750
  },
  "clock": {
    "referenceTime": "2000-01-01T06:00:00Z",
    "generatedAt": "2000-01-01T06:00:00Z",
    "startAt": "2000-01-01T12:00:00Z",
    "stepHours": 1,
    "hourCount": 6,
    "seed": 14003
  },
  "baseline": {
    "type": "synthetic",
    "path": "baselines/synthetic-five-level-day.source.json"
  },
  "transforms": [
    {
      "type": "surface-field-curve",
      "field": "temperatureC",
      "points": [
        {
          "hourOffset": 0,
          "value": 13
        },
        {
          "hourOffset": 2,
          "value": 18
        },
        {
          "hourOffset": 4,
          "value": 22
        },
        {
          "hourOffset": 5,
          "value": 21
        }
      ]
    },
    {
      "type": "surface-field-curve",
      "field": "sensibleHeatFluxWm2",
      "points": [
        {
          "hourOffset": 0,
          "value": 40
        },
        {
          "hourOffset": 2,
          "value": 230
        },
        {
          "hourOffset": 4,
          "value": 320
        },
        {
          "hourOffset": 5,
          "value": 180
        }
      ]
    },
    {
      "type": "temperature-offset",
      "altitudeBandM": {
        "bottomM": 1000,
        "topM": 1700
      },
      "offsetC": 9
    }
  ],
  "semantics": {
    "precipitation": "instantRate"
  },
  "capabilities": {
    "levels": true,
    "pressureLevels": [
      925,
      850,
      800,
      700,
      600
    ],
    "verticalVelocity": false,
    "heatFluxes": true,
    "gust": false,
    "cape": false,
    "cin": false,
    "pblHeight": false,
    "cloudLayers": false,
    "cloudProfile": false
  },
  "assertions": [
    {
      "id": "surface-heats",
      "description": "The capped column still experiences substantial surface warming.",
      "actual": {
        "field": "surface.temperatureC",
        "hour": 4
      },
      "operator": "greater-than",
      "expected": {
        "field": "surface.temperatureC",
        "hour": 0
      }
    },
    {
      "id": "heat-flux-grows",
      "description": "The sensible heat flux becomes strong beneath the persistent cap.",
      "actual": {
        "field": "surface.sensibleHeatFluxWm2",
        "hour": 4
      },
      "operator": "greater-than",
      "expected": {
        "field": "surface.sensibleHeatFluxWm2",
        "hour": 0
      }
    },
    {
      "id": "cap-stays-below-launch",
      "description": "Even at peak heating the boundary-layer top remains below launch.",
      "actual": {
        "field": "derived.boundaryLayerTopM",
        "hour": 4
      },
      "operator": "less-than",
      "expected": {
        "field": "launch.elevationM"
      }
    }
  ]
}
