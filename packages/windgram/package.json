{
  "name": "windgram",
  "version": "0.2.0",
  "description": "Contract, derivations, and reference renderer (scene graph + SVG) for windgram profile documents published by github.com/azohra/windgram.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azohra/windgram.git",
    "directory": "packages/windgram"
  },
  "type": "module",
  "files": [
    "dist",
    "schema"
  ],
  "exports": {
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "default": "./dist/contract/index.js"
    },
    "./derive": {
      "types": "./dist/derive/index.d.ts",
      "default": "./dist/derive/index.js"
    },
    "./scene": {
      "types": "./dist/scene/index.d.ts",
      "default": "./dist/scene/index.js"
    },
    "./svg": {
      "types": "./dist/svg/index.d.ts",
      "default": "./dist/svg/index.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "default": "./dist/presets/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas": "pnpm run build && node dist/internal/emit-json-schema.js"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
