{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Windgram model manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "model": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase hyphenated slug — the identity of models and sites everywhere."
    },
    "referenceTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "UTC instant, ISO 8601 with a Z suffix; fractional seconds tolerated."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "description": "UTC instant, ISO 8601 with a Z suffix; fractional seconds tolerated."
    },
    "firstForecastHour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lastForecastHour": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "forecastHours": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "memberCount": {
      "description": "Ensemble member count; ensemble models only.",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "sites": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Lowercase hyphenated slug — the identity of models and sites everywhere."
          }
        },
        "required": [
          "name",
          "slug"
        ]
      }
    },
    "stats": {
      "type": "object",
      "properties": {
        "downloads": {
          "type": "number",
          "description": "Transport requests made during the build (stable core)."
        },
        "downloadBytes": {
          "type": "number",
          "description": "Bytes fetched during the build (stable core)."
        },
        "retries": {
          "type": "number",
          "description": "Requests retried during the build (stable core)."
        },
        "durationMs": {
          "type": "number",
          "description": "Wall-clock build duration, ms (stable core)."
        }
      },
      "required": [
        "downloads",
        "downloadBytes",
        "retries",
        "durationMs"
      ],
      "additionalProperties": {
        "type": "number"
      },
      "description": "Build accounting: the four core keys (downloads, downloadBytes, retries, durationMs) are stable contract; every other key is transport-specific and UNSTABLE — builders add, rename, and drop them freely, so never build logic on them."
    }
  },
  "required": [
    "schemaVersion",
    "model",
    "referenceTime",
    "generatedAt",
    "firstForecastHour",
    "lastForecastHour",
    "forecastHours",
    "sites",
    "stats"
  ],
  "description": "Per-model build manifest, published at data/<model-slug>/manifest.json."
}
